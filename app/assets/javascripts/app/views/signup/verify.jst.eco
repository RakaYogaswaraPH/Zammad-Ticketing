<div class="signup fullscreen">
  <div class="fullscreen-center">
    <div class="hero-unit fullscreen-body">
      <h1><%- @T('Pendaftaran Berhasil!') %></h1>
      <p><%- @T('Terima kasih telah bergabung! Email verifikasi telah dikirim ke "%s".', @email) %></p>
      <p><%- @T('Silakan klik tautan di email verifikasi untuk mengaktifkan akun Anda.') %> <%- @T('Jika tidak menemukan emailnya, cek folder spam atau junk mail Anda.') %></p>
      <form>
        <input type="hidden" name="email" value="<%= @email %>">
        <div class="form-controls">
          <a class="btn btn--text btn--subtle js-cancel" href="#login"><%- @T('Kembali ke Login') %></a>
          <button class="btn btn--primary js-submitResend align-right"><%- @T('Kirim Ulang Email Verifikasi') %></button>
        </div>
      </form>
    </div>
  <% if !_.isEmpty(@public_links): %>
    <p>
      <% for link, link_index in @public_links: %>
        <% if link_index > 0: %> | <% end %>
        <a href="<%= link.link %>" title="<% if link.description: %><%= link.description %><% else: %><%= link.title %><% end %>"<% if link.new_tab: %> target="_blank"<% end %>><%= link.title %></a>
      <% end %>
    </p>
  <% end %>
  </div>
  <div class="poweredBy">
    <a href="https://zammad.org" target="_blank"><%- @Icon('logo') %></a>
    <%- @T('Powered by') %>
    <a href="https://zammad.org" target="_blank"><%- @Icon('logotype', 'logotype') %></a>
  </div>
</div>
