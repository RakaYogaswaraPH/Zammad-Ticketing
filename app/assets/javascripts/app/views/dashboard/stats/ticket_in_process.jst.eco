<div class="stat-widget vertical stat-widget--in-process">
  <div class="stat-title">
    <%- @T('Tiket Dalam Proses') %>
    <div class="stat-icon-help js-stat-help" title="<%- @Ti('Jumlah tiket yang saat ini berstatus terbuka dan sedang aktif ditindaklanjuti.') %>" data-placement="bottom">
      <%- @Icon('help') %>
    </div>
  </div>
  <div class="stat-graphic">
    <%- @Icon('in-process', "in-process-icon #{@StatsTicketInProcess.state}-color") %>
  </div>
  <div class="stat-label"><%- @T('%s Tiket Terbuka (Open)', @StatsTicketInProcess.in_process || @StatsTicketInProcess.open_count || 0) %></div>
  <div class="stat-detail"><%- @T('Tiket Aktif Sedang Ditangani') %></div>
</div>
