<div class="stat-widget vertical stat-widget--load">
  <div class="stat-title">
    <%- @T('Total Tiket Masuk') %>
    <div class="stat-icon-help js-stat-help" title="<%- @Ti('Jumlah keseluruhan tiket yang masuk ke dalam sistem helpdesk.') %>" data-placement="bottom">
      <%- @Icon('help') %>
    </div>
  </div>
  <div class="stat-graphic">
    <%- @Icon('total-tickets', 'total-tickets stat-icon') %>
  </div>
  <div class="stat-label"><%- @T('Total: %s Tiket', @StatsTicketLoadMeasure.total || 0) %></div>
  <div class="stat-detail"><%- @T('Seluruh Tiket Masuk Sistem') %></div>
</div>
