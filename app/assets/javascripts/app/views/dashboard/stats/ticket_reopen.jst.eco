<div class="stat-widget vertical stat-widget--reopen">
  <div class="stat-title">
    <%- @T('Tiket Dibuka Kembali') %>
    <div class="stat-icon-help js-stat-help" title="<%- @Ti('Jumlah akumulasi tiket yang pernah berstatus ditutup lalu dibuka kembali.') %>" data-placement="bottom">
      <%- @Icon('help') %>
    </div>
  </div>
  <div class="stat-graphic">
    <%- @Icon('reopening', "reopening-icon #{@StatsTicketReopen.state}-color") %>
  </div>
  <div class="stat-label"><%- @T('%s Kali Dibuka Ulang', @StatsTicketReopen.reopen_count || @StatsTicketReopen.count || 0) %></div>
  <div class="stat-detail"><%- @T('Status Ditutup Lalu Dibuka Ulang') %></div>
</div>
