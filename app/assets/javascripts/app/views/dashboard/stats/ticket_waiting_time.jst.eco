<div class="time stat-widget vertical stat-widget--time">
  <div class="stat-title">
    <%- @T('Ø Waktu Tanggap Hari Ini') %>
    <div class="stat-icon-help js-stat-help" title="<%- @Ti('Rata-rata waktu tunggu pelanggan untuk mendapatkan tanggapan hari ini.') %>" data-placement="bottom">
      <%- @Icon('help') %>
    </div>
  </div>
  <div class="stat-graphic">
    <div class="stat-stopwatch centered">
      <%- @Icon('stopwatch', 'stat-icon stopwatch-icon') %>
      <canvas class="stat-dial"></canvas>
      <div class="stat-amount"></div>
    </div>
  </div>
  <div class="stat-label"><%- @T('Waktu Tanggap: %s Menit', @StatsTicketWaitingTime.handling_time || 0) %></div>
  <div class="stat-detail"><%- @T('Rata-rata Sistem: %s Menit', @StatsTicketWaitingTime.average_per_agent || 0) %></div>
</div>
