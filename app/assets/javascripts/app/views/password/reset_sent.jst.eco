<div class="reset_password fullscreen">
  <div class="fullscreen-center">
    <div class="hero-unit fullscreen-body">
      <h2><%- @T('Petunjuk reset kata sandi telah dikirimkan ke alamat email Anda.') %><small></small></h2>
      <p><%- @T('Jika Anda tidak menerima email dalam beberapa menit, periksa folder spam atau junk Anda, atau coba kirim ulang permintaan Anda.') %></p>
      <div class="form-controls">
        <a class="btn btn--text btn--subtle js-cancel" href="#login"><%- @T('Kembali ke Login') %></a>
        <button class="btn btn--primary retry align-right"><%- @T('Kirim Ulang') %></button>
      </div>
    </div>
  <% if !_.isEmpty(@public_links): %>
    <p>
      <% for link, link_index in @public_links: %>
        <% if link_index > 0: %> | <% end %>
        <a href="<%= link.link %>"<% if link.description: %> title="<%- @T(link.description) %>"<% end %><% if link.new_tab: %> rel="noopener noreferrer" target="_blank"<% end %>><%- @T(link.title) %></a>
      <% end %>
    </p>
  <% end %>
  </div>
  <div class="poweredBy">
    <a href="https://zammad.org" target="_blank"><%- @Icon('logo') %></a>
    <%- @T('Powered by') %>
    <a href="https://zammad.org" target="_blank"><%- @Icon('logotype', 'logotype') %></a>
  </div>
</div>
