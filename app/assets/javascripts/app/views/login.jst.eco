<div class="login fullscreen diskominfo-fullscreen-page">
  <!-- Left Hero Image (50% Full Screen Call Center Theme) -->
  <div class="diskominfo-hero-section">
    <div class="diskominfo-hero-overlay"></div>
    
    <!-- Top Brand -->
    <div class="diskominfo-hero-header">
      <img class="diskominfo-hero-logo" src="<%= @logoUrl %>" alt="Diskominfo">
      <span class="diskominfo-hero-brand-name">Diskominfo</span>
    </div>

    <!-- Bottom Quote -->
    <div class="diskominfo-hero-footer">
      <blockquote class="diskominfo-hero-quote">
        “Pelayanan responsif, cepat, dan transparan untuk seluruh kebutuhan teknologi informasi Anda.”
      </blockquote>
      <div class="diskominfo-quote-author">IT Helpdesk Diskominfo</div>
      <div class="diskominfo-quote-dept">Pemerintah Kabupaten Bandung</div>
    </div>
  </div>

  <!-- Right Form Section (50% Full Screen) -->
  <div class="diskominfo-form-section">
    <div class="diskominfo-form-inner-wrapper">
      <div class="diskominfo-form-header">
        <h1 class="diskominfo-main-title">Selamat Datang</h1>
        <p class="diskominfo-main-subtitle">Layanan Bantuan Teknologi Informasi Diskominfo Kabupaten Bandung</p>
      </div>

      <% if @C('maintenance_mode'): %>
        <div class="alert alert--danger js-maintenanceMode">Zammad sedang dalam mode pemeliharaan. Hanya administrator yang dapat masuk.</div>
      <% end %>
      <% if @C('maintenance_login') && @C('maintenance_login_message'): %>
        <div class="alert alert--success js-maintenanceLogin"><%- @C('maintenance_login_message') %></div>
      <% end %>

      <% user_show_password_login = @C('user_show_password_login') || _.isEmpty(@auth_providers) %>

      <div class="diskominfo-form-content">
        <% if @item.showAdminPasswordLogin || user_show_password_login: %>
          <form id="login" class="js-form">
            <% if @item.errorMessage: %>
              <%
                msg = @item.errorMessage
                if msg && (msg.indexOf('Login failed') > -1 || msg.indexOf('credentials') > -1 || msg.indexOf('verification') > -1)
                  msg = 'Gagal masuk. Mohon periksa kembali username/email dan kata sandi Anda.'
                else if msg && msg.indexOf('two-factor') > -1
                  msg = 'Gagal masuk. Silakan periksa kembali metode autentikasi dua faktor Anda.'
                else if msg && msg.indexOf('Could not process your request') > -1
                  msg = 'Gagal memproses permintaan Anda. Silakan coba lagi.'
                end
              %>
              <div class="alert alert--danger" role="alert">
                <%- msg %>
              </div>
            <% end %>

            <div class="form-group">
              <div class="formGroup-label">
                <label for="username">Username / Email</label>
              </div>
              <input id="username" name="username" type="text" class="form-control" placeholder="Masukkan username atau email" value="<%= @item.formPayload?.username %>" autocapitalize="off" />
            </div>

            <div class="form-group">
              <div class="formGroup-label">
                <label for="password">Kata Sandi</label>
              </div>
              <input id="password" name="password" type="password" class="form-control" placeholder="••••••••" autocomplete="off"/>
            </div>

            <div class="form-group form-group--inline-actions">
              <label class="inline-label checkbox-replacement">
                <input name="remember_me" value="1" type="checkbox">
                <%- @Icon('checkbox', 'icon-unchecked') %>
                <%- @Icon('checkbox-checked', 'icon-checked') %>
                <span class="label-text">Ingat saya</span>
              </label>

              <% if @C('user_lost_password'): %>
                <a href="#password_reset" class="diskominfo-forgot-password-link">Lupa kata sandi?</a>
              <% end %>
            </div>

            <div class="form-controls">
              <button class="btn btn--primary btn--diskominfo-submit" type="submit">Masuk</button>
            </div>

          </form>
        <% else if @item.showAdminPasswordLoginFailed: %>
          <form id="login">
            <div class="alert alert--danger" role="alert">
              Token untuk login kata sandi admin tidak valid.
            </div>
          </form>
        <% end %>
      </div>

      <!-- Footer Info -->
      <div class="js-footer diskominfo-footer-section">
        <% if user_show_password_login: %>
          <div class="diskominfo-support-info">
            Sudah terdaftar dengan alamat email jika pernah menghubungi tim Support kami.<br>
            <% if @C('user_lost_password'): %>
              <a href="#password_reset" class="diskominfo-link">Anda dapat meminta kata sandi baru di sini.</a>
            <% end %>
          </div>
        <% end %>

        <% show_user_create_account = @C('user_create_account') && user_show_password_login %>
        <% if show_user_create_account || !_.isEmpty(@public_links): %>
          <div class="diskominfo-register-row">
            <% if show_user_create_account: %>
              <span class="diskominfo-register-prompt">Belum memiliki akun?</span>
              <a href="#signup" class="diskominfo-register-link">Daftar sebagai pengguna baru</a>
            <% end %>
            <% for link, link_index in @public_links: %>
              <% if link_index > 0 || show_user_create_account: %> | <% end %>
              <a href="<%= link.link %>" class="diskominfo-extra-link"<% if link.description: %> title="<%- @T(link.description) %>"<% end %><% if link.new_tab: %> rel="noopener noreferrer" target="_blank"<% end %>><%- @T(link.title) %></a>
            <% end %>
          </div>
        <% end %>

        <% if @show_mobile_link: %>
          <p class="diskominfo-mobile-switch">
            <a href="#" class="js-go-to-mobile">Beralih ke tampilan mobile</a>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
