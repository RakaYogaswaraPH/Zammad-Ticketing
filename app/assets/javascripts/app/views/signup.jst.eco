<div class="signup fullscreen">
  <div class="fullscreen-center">
    <div class="hero-unit fullscreen-body">
      <h1><%- @T('Daftar Akun Baru') %></h1>
      <form>
        <p class="diskominfo-pw-hint" style="font-size:12px;color:#6b7280;margin:4px 0 12px;line-height:1.5;">
          <%- @T('Syarat kata sandi: minimal 10 karakter, mengandung huruf besar, huruf kecil, dan angka.') %>
        </p>
        <div class="form-controls">
          <a class="btn btn--text btn--subtle js-cancel" href="#login"><%- @T('Batal & Kembali') %></a>
          <button class="btn btn--primary js-submit align-right"><%- @T('Buat Akun Saya') %></button>
        </div>
      </form>
    </div>
  <% if !_.isEmpty(@public_links): %>
    <p>
      <% for link, link_index in @public_links: %>
        <% if link_index > 0: %> | <% end %>
        <a href="<%= link.link %>"<% if link.description: %> title="<%- @T(link.description) %>"<% end %><% if link.new_tab: %> rel="noopener noreferrer" target="_blank"<% end %>><%- @T(link.title) %></a>
      <% end %>
    </p>
  <% end %>
  </div>
  <div class="poweredBy">
    <a href="https://zammad.org" target="_blank"><%- @Icon('logo') %></a>
    <%- @T('Powered by') %>
    <a href="https://zammad.org" target="_blank"><%- @Icon('logotype', 'logotype') %></a>
  </div>
</div>
