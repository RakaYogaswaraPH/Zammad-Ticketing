<!-- svgstore fallback -->
<%= javascript_tag nonce: true do -%>
  /*
    detect if browser is
    - Chrome 14-20
    - Android Browser 4.1+
    - iOS 6-7
    - Safari 6
    - Edge 12
    - IE 9-11
  */
  window.svgPolyfill = /\bEdge\/12\b|\bTrident\/[567]\b|\bVersion\/7.0 Safari\b/.test(navigator.userAgent) || (navigator.userAgent.match(/AppleWebKit\/(\d+)/) || [])[1] < 537;

  (function (doc) {
    if(!svgPolyfill)
      return

    var scripts = doc.getElementsByTagName('script')
    var script = scripts[scripts.length - 1]
    var xhr = new XMLHttpRequest()
    xhr.onload = function () {
      var div = doc.createElement('div')
      div.innerHTML = this.responseText
      div.style.cssText = 'position: absolute; clip: rect(0, 0, 0, 0); z-index: -1;'
      script.parentNode.insertBefore(div, script)
    }
    xhr.open('get', '<%= icons_url %>', true)
    xhr.send()
  })(document)
<% end -%>
<%
  logo_asset = begin
    Service::SystemAssets.backend('product_logo')&.sendable_asset
  rescue => e
    nil
  end
  logo_src = if logo_asset
    "data:#{logo_asset.type};base64,#{Base64.strict_encode64(logo_asset.content)}"
  else
    "/api/v1/system_assets/product_logo/#{Setting.get('product_logo')}"
  end
-%>
<div id="app"></div>
<div class="splash diskominfo-gmail-splash" id="diskominfo-splash-screen">
  <div class="diskominfo-splash-container">
    <div class="diskominfo-splash-logo-wrapper">
      <img class="diskominfo-splash-logo" src="<%= logo_src %>" alt="Diskominfo Logo" fetchpriority="high" loading="eager" />
    </div>

    <div class="diskominfo-splash-title">IT Helpdesk</div>
    <div class="diskominfo-splash-sub">Diskominfo Kabupaten Bandung</div>

    <div class="diskominfo-splash-progress-track" style="width: 100%; max-width: 260px; height: 8px; background-color: #e2e8f0; border-radius: 9999px; overflow: hidden; position: relative; margin: 0 auto 14px auto; box-shadow: inset 0 1px 2px rgba(0,0,0,0.08);">
      <div class="diskominfo-splash-progress-bar" id="diskominfo-progress-bar" style="position: absolute; top: 0; left: 0; bottom: 0; height: 100%; width: 0%; background: linear-gradient(90deg, #092c5e, #0b5ed7); background-color: #092c5e; border-radius: 9999px; transition: width 0.15s ease-out;"></div>
    </div>

    <div class="diskominfo-splash-loading-text">
      Memuat aplikasi... <span id="diskominfo-progress-percent">0%</span>
    </div>
  </div>
  <noscript>
    <style>
      .splash { flex-direction: column; }
      .splash-title { display: none; }
    </style>
    <div style="margin-top: 16px; color: #ef4444; font-weight: 600;">
      <%= Translation.translate(local_assigns[:locale], 'Turn on JavaScript to use Zammad.') %>
    </div>
  </noscript>
</div>

<%= javascript_tag nonce: true do -%>
  (function() {
    var percentEl = document.getElementById('diskominfo-progress-percent');
    var barEl = document.getElementById('diskominfo-progress-bar');
    var splashEl = document.getElementById('diskominfo-splash-screen');
    var current = 0;
    var isFinishing = false;
    var isDone = false;

    function setProgress(val) {
      if (barEl) barEl.style.width = val + '%';
      if (percentEl) percentEl.textContent = val + '%';
    }

    var timer = setInterval(function() {
      if (isFinishing || isDone) return;
      if (current < 92) {
        current += Math.floor(Math.random() * 8) + 3;
        if (current > 92) current = 92;
        setProgress(current);
      }
    }, 80);

    function finishLoading() {
      if (isFinishing || isDone) return;
      isFinishing = true;
      clearInterval(timer);
      setProgress(100);

      // Brief pause so 100% is visible, then start smooth fadeout
      setTimeout(function() {
        if (!splashEl) return;
        splashEl.classList.add('diskominfo-splash-fadeout');

        setTimeout(function() {
          isDone = true;
          splashEl.style.setProperty('display', 'none', 'important');
          if (splashEl.parentNode) splashEl.parentNode.removeChild(splashEl);
        }, 500);
      }, 200);
    }

    if (splashEl) {
      var splashObserver = new MutationObserver(function() {
        if (isDone) return;
        if (splashEl.style.display === 'none' && !isFinishing) {
          splashEl.style.display = 'flex';
          finishLoading();
        }
      });
      splashObserver.observe(splashEl, { attributes: true, attributeFilter: ['style'] });
    }

    var checkAppInterval = setInterval(function() {
      var appEl = document.getElementById('app');
      var heroUnit = document.querySelector('.hero-unit') || document.querySelector('.diskominfo-hero-section') || document.querySelector('.navigation');
      if (heroUnit || (appEl && appEl.children.length > 0)) {
        clearInterval(checkAppInterval);
        finishLoading();
      }
    }, 60);

    // Fallback: Never let the preloader hang indefinitely (e.g. mobile networks or delayed DOM elements)
    setTimeout(function() {
      if (!isFinishing && !isDone) {
        clearInterval(checkAppInterval);
        finishLoading();
      }
    }, 3500);
  })();
<% end -%>
