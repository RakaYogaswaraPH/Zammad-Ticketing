<style>
body,
html,
#loading-app,
#app[data-loaded="true"] {
  height: 100%;
}
html, body {
  margin: 0;
  padding: 0;
  background-color: #ffffff !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #1e293b;
}

#loading-app {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  background-color: #ffffff !important;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 99999;
}

.diskominfo-preloader-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  max-width: 360px;
  width: 100%;
  padding: 24px;
  box-sizing: border-box;
}

/* Diskominfo Logo animation */
.diskominfo-preloader-logo-wrapper {
  margin-bottom: 24px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.diskominfo-preloader-logo {
  height: 76px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 4px 12px rgba(11, 94, 215, 0.15));
  animation: preloaderPulse 2s ease-in-out infinite;
}

@keyframes preloaderPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.95;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

/* Preloader Brand Title */
.diskominfo-preloader-title {
  font-size: 22px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.4px;
  margin-bottom: 4px;
}

.diskominfo-preloader-sub {
  font-size: 13.5px;
  font-weight: 500;
  color: #64748b;
  margin-bottom: 32px;
}

/* Gmail-style Animated Progress Bar */
.diskominfo-progress-track {
  width: 100%;
  max-width: 240px;
  height: 4px;
  background-color: #e2e8f0;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
  margin-bottom: 18px;
}

.diskominfo-progress-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #0b5ed7, #2563eb, #3b82f6);
  border-radius: 4px;
  animation: gmailLoading 1.8s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
}

@keyframes gmailLoading {
  0% {
    left: -100%;
    width: 100%;
  }
  50% {
    left: 25%;
    width: 75%;
  }
  100% {
    left: 100%;
    width: 100%;
  }
}

/* Loading label text */
.diskominfo-loading-text {
  font-size: 13px;
  font-weight: 500;
  color: #64748b;
  letter-spacing: 0.2px;
}

.loading-failed {
  position: relative;
  opacity: 0;
  color: #ef4444;
  text-align: center;
  margin-top: 16px;
  transition: opacity 0.5s;
  font-weight: 600;
  font-size: 13px;
}

.loading-failed.active {
  opacity: 1;
}

.noscript-message {
  color: #ef4444;
  text-align: center;
  font-weight: 600;
  margin-top: 16px;
  font-size: 13px;
}
</style>

<%
  logo_asset = begin
    Service::SystemAssets.backend('product_logo')&.sendable_asset
  rescue => e
    nil
  end
  logo_src = if logo_asset
    "data:#{logo_asset.type};base64,#{Base64.strict_encode64(logo_asset.content)}"
  else
    "/api/v1/system_assets/product_logo/#{Setting.get('product_logo')}"
  end
-%>

<div id="loading-app">
  <div class="diskominfo-preloader-container">
    <div class="diskominfo-preloader-logo-wrapper">
      <img class="diskominfo-preloader-logo" src="<%= logo_src %>" alt="Diskominfo Logo" id="diskominfo-preloader-img" />
    </div>

    <div class="diskominfo-preloader-title">IT Helpdesk</div>
    <div class="diskominfo-preloader-sub">Diskominfo Kabupaten Bandung</div>

    <div class="diskominfo-progress-track">
      <div class="diskominfo-progress-bar"></div>
    </div>

    <div class="diskominfo-loading-text">Memuat aplikasi...</div>

    <div class="loading-failed" aria-hidden="true">
      <%= Translation.translate(local_assigns[:locale], 'Loading failed, please try again later.') %>
    </div>
    <noscript>
      <div class="noscript-message">
        <%= Translation.translate(local_assigns[:locale], 'Turn on JavaScript to use Zammad.') %>
      </div>
    </noscript>
  </div>
</div>
