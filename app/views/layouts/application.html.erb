            }
          }
          return;
        }

        if (isCustomerUser()) {
          window.location.hash = '#';
          alert('Akses ditolak. Laporan SLA hanya dapat diakses oleh petugas support dan admin.');
          return;
        }

        // On initial hard refresh, Spine may still be booting session and hasn't mounted #navigation yet.
        // Wait for #navigation so the sidebar and SLA view appear atomically together without flashing!
        var navEl = document.getElementById('navigation');
        if (!navEl && (!_navWaitCount || _navWaitCount < 50)) {
          _navWaitCount = (_navWaitCount || 0) + 1;
          if (!_navWaitTimer) {
            _navWaitTimer = setInterval(function() {
              _navWaitCount = (_navWaitCount || 0) + 1;
              if (document.getElementById('navigation') || _navWaitCount >= 50) {
                clearInterval(_navWaitTimer);
                _navWaitTimer = null;
                _navWaitCount = 0;
                enhanceSlaSidebarMenu();
                enhanceSlaReportRoute();
              }
            }, 30);
          }
          return;
        }
        if (_navWaitTimer) {
          clearInterval(_navWaitTimer);
          _navWaitTimer = null;
          _navWaitCount = 0;
        }

        // Ensure sidebar has SLA menu item immediately
        enhanceSlaSidebarMenu();

        // Hide any background tasks from TaskManager so SLA Report gets full width
        if (window.App && window.App.TaskManager && typeof window.App.TaskManager.hideAll === 'function') {
          try { window.App.TaskManager.hideAll(); } catch(e) {}
        }

        var appEl = document.getElementById('app') || document.body;
        var contentEl = document.getElementById('content');
        if (!contentEl) {
          contentEl = document.createElement('div');
          contentEl.id = 'content';
          contentEl.className = 'content flex horizontal active';
          appEl.appendChild(contentEl);
        }

        contentEl.classList.remove('hide');
        contentEl.classList.add('active');
        contentEl.style.setProperty('display', 'flex', 'important');
        contentEl.style.setProperty('flex-direction', 'column', 'important');
        contentEl.style.setProperty('flex', '1 1 auto', 'important');
        contentEl.style.setProperty('min-height', '100vh', 'important');
        contentEl.style.setProperty('overflow-y', 'auto', 'important');
        contentEl.style.removeProperty('width');
        contentEl.style.removeProperty('background');

        // Hide all sibling views inside #content so SLA report is 100% full width
        for (var i = 0; i < contentEl.children.length; i++) {
          var child = contentEl.children[i];
          if (child.id !== 'sla-reporting-container') {
            child.style.setProperty('display', 'none', 'important');
            child.classList.add('hide');
          }
        }

        // Hide any task pane outside #content
        var siblingTasks = document.querySelectorAll('#app > .main, #app > .task, #app > .tabsSidebar-holder');
        siblingTasks.forEach(function(st) {
          st.style.setProperty('display', 'none', 'important');
        });

        // Deactivate active task buttons in navigation
        document.querySelectorAll('.tasks-navigation .is-active').forEach(function(tab) {
          tab.classList.remove('is-active');
        });

        var slaContainer = document.getElementById('sla-reporting-container');
        if (!slaContainer) {
          slaContainer = document.createElement('div');
          slaContainer.id = 'sla-reporting-container';
          slaContainer.className = 'sla-report-container';
          slaContainer.style.setProperty('flex', '1 1 100%', 'important');
          slaContainer.style.setProperty('width', '100%', 'important');
          slaContainer.style.setProperty('min-height', '100vh', 'important');
          slaContainer.style.setProperty('display', 'block', 'important');
          slaContainer.style.setProperty('overflow-y', 'auto', 'important');
          slaContainer.style.setProperty('box-sizing', 'border-box', 'important');
          contentEl.appendChild(slaContainer);
          loadSlaReportData();
        } else {
          slaContainer.style.setProperty('display', 'block', 'important');
          slaContainer.style.setProperty('width', '100%', 'important');
        }
      }

      var _navWaitTimer = null;
      var _navWaitCount = 0;

      function loadSlaReportData(showLoader) {
        if (_slaIsLoading) return;
        _slaIsLoading = true;

        var container = document.getElementById('sla-reporting-container');
        if (container && (!_slaSummary || showLoader)) {
          container.innerHTML = 
            '<div class="sla-loading-container">' +
              '<div class="sla-loading-box">' +
                '<div class="sla-loading-title">Memuat Laporan SLA &amp; Durasi Tiket...</div>' +
                '<div class="sla-loading-sub">Mengagregasikan data tiket selesai dari database</div>' +
                '<div class="sla-progress-track">' +
                  '<div class="sla-progress-fill"></div>' +
                '</div>' +
              '</div>' +
            '</div>';
        }

        var qParams = [];
        if (_slaFilters.from) qParams.push('from=' + encodeURIComponent(_slaFilters.from));
        if (_slaFilters.to) qParams.push('to=' + encodeURIComponent(_slaFilters.to));
        if (_slaFilters.group_id) qParams.push('group_id=' + encodeURIComponent(_slaFilters.group_id));
        if (_slaFilters.priority_id) qParams.push('priority_id=' + encodeURIComponent(_slaFilters.priority_id));
        var queryStr = qParams.length ? ('?' + qParams.join('&')) : '';

        var ticketsParams = qParams.slice();
        ticketsParams.push('page=' + (_slaFilters.page || 1));
        if (_slaFilters.query) ticketsParams.push('query=' + encodeURIComponent(_slaFilters.query));
        var ticketsQueryStr = '?' + ticketsParams.join('&');

        Promise.all([
          fetch('/api/v1/sla_reports/filters_meta', { headers: { 'Accept': 'application/json' } }).then(function(r) { return r.json(); }),
          fetch('/api/v1/sla_reports/summary' + queryStr, { headers: { 'Accept': 'application/json' } }).then(function(r) { return r.json(); }),
          fetch('/api/v1/sla_reports/chart_data' + queryStr, { headers: { 'Accept': 'application/json' } }).then(function(r) { return r.json(); }),
          fetch('/api/v1/sla_reports/tickets' + ticketsQueryStr, { headers: { 'Accept': 'application/json' } }).then(function(r) { return r.json(); })
        ])
        .then(function(results) {
          _slaIsLoading = false;
          _slaMeta = results[0];
          _slaSummary = results[1];
          _slaChartData = results[2];
          _slaTickets = results[3];
          renderSlaDashboard();
        })
        .catch(function(err) {
          _slaIsLoading = false;
          if (container) {
            container.innerHTML = '<div style="text-align:center;padding:60px 20px;color:#ef4444;">' +
                                  '<div style="font-size:32px;margin-bottom:8px;">⚠️</div>' +
                                  '<div style="font-weight:700;">Gagal memuat data laporan SLA</div>' +
                                  '<button type="button" class="sla-btn-secondary" style="margin-top:14px;" onclick="loadSlaReportData(true)">Coba Lagi</button>' +
                                  '</div>';
          }
        });
      }

      function renderSlaDashboard() {
        var container = document.getElementById('sla-reporting-container');
        if (!container) return;

        var sum = _slaSummary || {};
        var charts = _slaChartData || {};
        var tickData = _slaTickets || { tickets: [], total_count: 0, page: 1, total_pages: 1 };

        // 1. Header
        var html = '<div class="sla-header">' +
                   '<div>' +
                     '<h1 class="sla-header-title">Laporan SLA & Durasi Pengerjaan Tiket</h1>' +
                     '<p class="sla-header-sub">Track record durasi penyelesaian tiket dari saat masuk hingga ditutup.</p>' +
                   '</div>' +
                   '<div style="display:flex;gap:10px;align-items:center;">' +
                     '<button type="button" class="sla-btn-secondary js-sla-refresh"><span>🔄</span> Muat Ulang</button>' +
                     '<button type="button" class="sla-btn-primary js-sla-export"><span>📥</span> Export CSV</button>' +
                   '</div>' +
                   '</div>';

        // 2. Filters Card
        html += '<div class="sla-filters-card">' +
                '<div class="sla-filter-item">' +
                  '<label>Tanggal:</label>' +
                  '<input type="date" class="sla-filter-input js-sla-from" value="' + escapeHtml(_slaFilters.from) + '" title="Dari Tanggal">' +
                  '<span>s/d</span>' +
                  '<input type="date" class="sla-filter-input js-sla-to" value="' + escapeHtml(_slaFilters.to) + '" title="Sampai Tanggal">' +
                '</div>' +
                '<div class="sla-filter-item">' +
                  '<label>Grup:</label>' +
                  '<select class="sla-filter-input js-sla-group">' +
                    '<option value="">Semua Grup</option>';
        if (_slaMeta && _slaMeta.groups) {
          _slaMeta.groups.forEach(function(g) {
            var sel = String(_slaFilters.group_id) === String(g.id) ? ' selected' : '';
            html += '<option value="' + g.id + '"' + sel + '>' + escapeHtml(g.name) + '</option>';
          });
        }
        html += '</select></div>' +
                '<div class="sla-filter-item">' +
                  '<label>Prioritas:</label>' +
                  '<select class="sla-filter-input js-sla-priority">' +
                    '<option value="">Semua Prioritas</option>';
        if (_slaMeta && _slaMeta.priorities) {
          _slaMeta.priorities.forEach(function(p) {
            var pSel = String(_slaFilters.priority_id) === String(p.id) ? ' selected' : '';
            html += '<option value="' + p.id + '"' + pSel + '>' + escapeHtml(p.name) + '</option>';
          });
        }
        html += '</select></div>' +
                '<button type="button" class="sla-btn-primary js-sla-apply-filter" style="padding:7px 16px;">Terapkan Filter</button>' +
                '</div>';

        // 3. Metric Cards Grid
        var totalClosed = sum.total_closed || 0;
        var avgDuration = (sum.average_duration_human && sum.average_duration_human !== '0 menit') ? sum.average_duration_human : null;
        var minDuration = (sum.min_duration_human && sum.min_duration_human !== '0 menit') ? sum.min_duration_human : null;
        var maxDuration = (sum.max_duration_human && sum.max_duration_human !== '0 menit') ? sum.max_duration_human : null;

        html += '<div class="sla-metrics-grid">' +
                '<div class="sla-metric-card">' +
                  '<div class="sla-metric-label">TOTAL TIKET SELESAI</div>' +
                  (totalClosed > 0
                    ? '<div class="sla-metric-val" style="color:#0284c7;">' + totalClosed + ' <span style="font-size:15px;font-weight:600;color:#64748b;">Tiket</span></div>'
                    : '<div class="sla-metric-val sla-empty-val">Data Kosong</div>') +
                  '<div class="sla-metric-sub">Tiket berstatus closed</div>' +
                '</div>' +
                '<div class="sla-metric-card">' +
                  '<div class="sla-metric-label">RATA-RATA DURASI PENGERJAAN</div>' +
                  (avgDuration
                    ? '<div class="sla-metric-val">' + escapeHtml(avgDuration) + '</div>'
                    : '<div class="sla-metric-val sla-empty-val">Data Kosong</div>') +
                  '<div class="sla-metric-sub">Dihitung dari tiket dibuat s/d ditutup</div>' +
                '</div>' +
                '<div class="sla-metric-card">' +
                  '<div class="sla-metric-label">DURASI TERCEPAT &amp; TERLAMA</div>' +
                  (minDuration
                    ? '<div class="sla-metric-val" style="font-size:20px;color:#16a34a;">' + escapeHtml(minDuration) + '</div>' +
                      '<div class="sla-metric-sub">Terlama: ' + escapeHtml(maxDuration || 'Data Kosong') + '</div>'
                    : '<div class="sla-metric-val sla-empty-val">Data Kosong</div>' +
                      '<div class="sla-metric-sub">Belum ada tiket selesai</div>') +
                '</div>' +
                '</div>';

        // 4. Charts Grid (SVG Line Chart + Distribution Progress Bars)
        var trendInfo = getSlaTrendInfo(charts.daily_trend);
        html += '<div class="sla-charts-grid">' +
                '<div class="sla-card-panel">' +
                  '<div class="sla-card-title"><span>' + escapeHtml(trendInfo.title) + '</span></div>' +
                  '<div class="sla-trend-chart-wrapper" style="height:220px;position:relative;">' +
                    generateSlaSvgTrendChart(charts.daily_trend, trendInfo.isMinutes) +
                  '</div>' +
                '</div>' +
                '<div class="sla-card-panel">' +
                  '<div class="sla-card-title"><span>Waktu Pengerjaan Tiket</span></div>' +
                  '<div class="sla-dist-bars-wrapper">' +
                    generateSlaDistributionBars(charts.distribution, sum.total_closed) +
                  '</div>' +
                '</div>' +
                '</div>';

        // 5. Track Record Tickets Table
        html += '<div class="sla-card-panel">' +
                '<div class="sla-card-title">' +
                  '<span>Rincian Durasi Pengerjaan Tiket (' + tickData.total_count + ' Tiket)</span>' +
                  '<input type="text" class="sla-filter-input js-sla-search-query" placeholder="🔍 Cari nomor / judul..." value="' + escapeHtml(_slaFilters.query || '') + '" style="font-weight:normal;width:220px;">' +
                '</div>' +
                '<div class="sla-table-wrapper">' +
                '<table class="sla-table">' +
                '<thead><tr>' +
                  '<th>No. Tiket</th>' +
                  '<th>Judul Kendala</th>' +
                  '<th>Customer</th>' +
                  '<th>Petugas</th>' +
                  '<th>Grup</th>' +
                  '<th>Waktu Masuk</th>' +
                  '<th>Waktu Selesai</th>' +
                  '<th>Durasi Pengerjaan</th>' +
                '</tr></thead><tbody>';

        if (tickData.tickets && tickData.tickets.length > 0) {
          tickData.tickets.forEach(function(t) {
            var badgeClass = 'sla-badge-normal';
            if (t.duration_min < 60) badgeClass = 'sla-badge-fast';
            else if (t.duration_min > 1440) badgeClass = 'sla-badge-exceed';
            else if (t.duration_min > 240) badgeClass = 'sla-badge-slow';

            html += '<tr>' +
                    '<td><a href="#ticket/zoom/' + t.id + '" style="font-weight:700;color:#0284c7;text-decoration:none;">#' + escapeHtml(t.number) + '</a></td>' +
                    '<td style="font-weight:600;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + escapeHtml(t.title) + '">' + escapeHtml(t.title) + '</td>' +
                    '<td>' + escapeHtml(t.customer_name) + '</td>' +
                    '<td>' + escapeHtml(t.owner_name) + '</td>' +
                    '<td><span class="sla-metric-sub" style="font-size:12px;">' + escapeHtml(t.group_name) + '</span></td>' +
                    '<td class="sla-metric-sub" style="font-size:12px;">' + escapeHtml(t.created_at) + '</td>' +
                    '<td class="sla-metric-sub" style="font-size:12px;">' + escapeHtml(t.close_at) + '</td>' +
                    '<td><span class="' + badgeClass + '">' + escapeHtml(t.duration_human) + '</span></td>' +
                    '</tr>';
          });
        } else {
          html += '<tr><td colspan="8" style="text-align:center;padding:32px;" class="sla-metric-sub">Tidak ada tiket yang cocok dengan filter yang dipilih.</td></tr>';
        }

        html += '</tbody></table></div>';

        // Pagination
        if (tickData.total_pages > 1) {
          html += '<div class="sla-pagination" style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:12px;">' +
                  '<div class="sla-metric-sub" style="font-size:13px;">Halaman ' + tickData.page + ' dari ' + tickData.total_pages + ' (' + tickData.total_count + ' total tiket)</div>' +
                  '<div style="display:flex;gap:8px;">' +
                    '<button type="button" class="sla-btn-secondary js-sla-prev-page"' + (tickData.page <= 1 ? ' disabled style="opacity:0.5;cursor:default;"' : '') + '>← Sebelumnya</button>' +
                    '<button type="button" class="sla-btn-secondary js-sla-next-page"' + (tickData.page >= tickData.total_pages ? ' disabled style="opacity:0.5;cursor:default;"' : '') + '>Berikutnya →</button>' +
                  '</div>' +
                  '</div>';
        }
        html += '</div>';

        container.innerHTML = html;

        // Bind Events
        container.querySelector('.js-sla-refresh').addEventListener('click', function() {
          _slaSummary = null;
          loadSlaReportData(true);
        });

        container.querySelector('.js-sla-export').addEventListener('click', function() {
          exportSlaCsv();
        });

        container.querySelector('.js-sla-apply-filter').addEventListener('click', function() {
          _slaFilters.from = container.querySelector('.js-sla-from').value;
          _slaFilters.to = container.querySelector('.js-sla-to').value;
          _slaFilters.group_id = container.querySelector('.js-sla-group').value;
          _slaFilters.priority_id = container.querySelector('.js-sla-priority').value;
          _slaFilters.page = 1;
          loadSlaReportData();
        });

        var searchInput = container.querySelector('.js-sla-search-query');
        if (searchInput) {
          searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              _slaFilters.query = this.value.trim();
              _slaFilters.page = 1;
              loadSlaReportData();
            }
          });
        }

        var prevBtn = container.querySelector('.js-sla-prev-page');
        if (prevBtn && !prevBtn.disabled) {
          prevBtn.addEventListener('click', function() {
            _slaFilters.page = Math.max(1, (_slaFilters.page || 1) - 1);
            loadSlaReportData();
          });
        }

        var nextBtn = container.querySelector('.js-sla-next-page');
        if (nextBtn && !nextBtn.disabled) {
          nextBtn.addEventListener('click', function() {
            _slaFilters.page = (_slaFilters.page || 1) + 1;
            loadSlaReportData();
          });
        }
      }

      function getSlaTrendInfo(dailyData) {
        var defaultTitle = 'Tren Durasi Penyelesaian (Jam per Hari)';
        if (!dailyData || !dailyData.labels || dailyData.labels.length === 0) {
          return { isMinutes: false, title: defaultTitle };
        }

        var rawMinutes = dailyData.avg_minutes;
        if (!rawMinutes && dailyData.avg_hours) {
          rawMinutes = dailyData.avg_hours.map(function(h) { return Math.round(h * 60 * 10) / 10; });
        }
        var maxM = (rawMinutes && rawMinutes.length > 0) ? Math.max.apply(null, rawMinutes) : 0;
        var isMinutes = maxM < 60;

        return {
          isMinutes: isMinutes,
          title: isMinutes ? 'Tren Durasi Penyelesaian (Menit per Hari)' : 'Tren Durasi Penyelesaian (Jam per Hari)'
        };
      }

      function generateSlaSvgTrendChart(dailyData, isMinutes) {
        if (!dailyData || !dailyData.labels || dailyData.labels.length === 0) {
          return '<div style="display:flex;align-items:center;justify-content:center;height:100%;font-size:13px;" class="sla-metric-sub">Belum ada tren waktu harian untuk periode ini.</div>';
        }

        var dark = isDarkTheme();
        var gridColor = dark ? '#334155' : '#e2e8f0';
        var axisTextColor = dark ? '#94a3b8' : '#94a3b8';
        var labelColor = dark ? '#cbd5e1' : '#64748b';
        var dotStroke = dark ? '#1e293b' : '#ffffff';

        var labels = dailyData.labels;
        var counts = dailyData.counts || [];

        // Check values in minutes
        var rawMinutes = dailyData.avg_minutes;
        if (!rawMinutes && dailyData.avg_hours) {
          rawMinutes = dailyData.avg_hours.map(function(h) { return Math.round(h * 60 * 10) / 10; });
        }
        if (!rawMinutes) rawMinutes = [];

        if (typeof isMinutes === 'undefined') {
          var maxM = rawMinutes.length > 0 ? Math.max.apply(null, rawMinutes) : 0;
          isMinutes = maxM < 60;
        }

        var vals = [];
        var unitSuffix = isMinutes ? 'm' : 'j';
        var unitName = isMinutes ? 'menit' : 'jam';

        if (isMinutes) {
          vals = rawMinutes.map(function(m) {
            return Math.round(m * 10) / 10;
          });
        } else {
          if (dailyData.avg_hours) {
            vals = dailyData.avg_hours.map(function(h) {
              return Math.round(h * 10) / 10;
            });
          } else {
            vals = rawMinutes.map(function(m) {
              return Math.round((m / 60) * 10) / 10;
            });
          }
        }

        var peakVal = vals.length > 0 ? Math.max.apply(null, vals) : 0;
        if (peakVal <= 0) peakVal = isMinutes ? 10 : 1;

        var maxVal;
        if (isMinutes) {
          var targetMax = Math.ceil(peakVal * 1.2);
          var possibleSteps = [1, 2, 3, 5, 10, 15, 20, 30];
          var chosenStep = Math.ceil(targetMax / 3);
          for (var s = 0; s < possibleSteps.length; s++) {
            if (possibleSteps[s] * 3 >= targetMax) {
              chosenStep = possibleSteps[s];
              break;
            }
          }
          maxVal = Math.max(3, chosenStep * 3);
        } else {
          var targetMax = Math.ceil(peakVal * 1.25);
          var possibleSteps = [0.5, 1, 2, 3, 4, 5, 10, 24];
          var chosenStep = Math.ceil(targetMax / 3);
          for (var s = 0; s < possibleSteps.length; s++) {
            if (possibleSteps[s] * 3 >= targetMax) {
              chosenStep = possibleSteps[s];
              break;
            }
          }
          maxVal = Math.max(1, chosenStep * 3);
        }

        var width = 460;
        var height = 180;
        var paddingLeft = 40;
        var paddingBottom = 30;
        var chartW = width - paddingLeft - 20;
        var chartH = height - paddingBottom - 20;

        var points = [];
        var stepX = labels.length > 1 ? (chartW / (labels.length - 1)) : (chartW / 2);

        for (var i = 0; i < vals.length; i++) {
          var px = paddingLeft + (labels.length > 1 ? (i * stepX) : (chartW / 2));
          var py = 10 + (chartH - ((vals[i] / maxVal) * chartH));
          points.push({ x: px, y: py, val: vals[i], label: labels[i], count: counts[i] || 0 });
        }

        var pathD = '';
        var areaD = '';
        if (points.length > 1) {
          pathD = 'M ' + points[0].x + ' ' + points[0].y;
          for (var p = 1; p < points.length; p++) {
            pathD += ' L ' + points[p].x + ' ' + points[p].y;
          }
          areaD = pathD + ' L ' + points[points.length - 1].x + ' ' + (10 + chartH) + ' L ' + points[0].x + ' ' + (10 + chartH) + ' Z';
        }

        var svg = '<svg viewBox="0 0 ' + width + ' ' + height + '" style="width:100%;height:100%;overflow:visible;">';

        // Grid lines (4 lines: g = 0 top, g = 3 bottom)
        for (var g = 0; g <= 3; g++) {
          var gy = 10 + (chartH * (g / 3));
          var rawGVal = maxVal * (1 - (g / 3));
          var gText = (rawGVal % 1 === 0 ? rawGVal.toFixed(0) : rawGVal.toFixed(1)) + unitSuffix;
          svg += '<line x1="' + paddingLeft + '" y1="' + gy + '" x2="' + (width - 20) + '" y2="' + gy + '" stroke="' + gridColor + '" stroke-dasharray="3,3" stroke-width="1"/>' +
                 '<text x="' + (paddingLeft - 8) + '" y="' + (gy + 4) + '" fill="' + axisTextColor + '" font-size="10" text-anchor="end">' + gText + '</text>';
        }

        // Area gradient fill & Line (only if > 1 points)
        svg += '<defs>' +
               '<linearGradient id="slaGradient" x1="0" y1="0" x2="0" y2="1">' +
               '<stop offset="0%" stop-color="#0284c7" stop-opacity="0.3"/>' +
               '<stop offset="100%" stop-color="#0284c7" stop-opacity="0.0"/>' +
               '</linearGradient>' +
               '</defs>';

        if (points.length > 1) {
          svg += '<path d="' + areaD + '" fill="url(#slaGradient)"/>' +
                 '<path d="' + pathD + '" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>';
        }

        // Points & Labels
        points.forEach(function(pt) {
          var displayVal = (pt.val % 1 === 0) ? pt.val.toFixed(0) : pt.val.toFixed(1);
          var textY = pt.y - 10;
          if (textY < 18) textY = pt.y + 16;

          svg += '<circle cx="' + pt.x + '" cy="' + pt.y + '" r="5" fill="#0284c7" stroke="' + dotStroke + '" stroke-width="2">' +
                 '<title>' + pt.label + ': ' + displayVal + ' ' + unitName + ' (' + pt.count + ' tiket)</title>' +
                 '</circle>';

          if (points.length <= 7) {
            svg += '<text x="' + pt.x + '" y="' + textY + '" fill="' + (dark ? '#38bdf8' : '#0284c7') + '" font-size="10" font-weight="600" text-anchor="middle">' + displayVal + unitSuffix + '</text>';
          }

          svg += '<text x="' + pt.x + '" y="' + (height - 8) + '" fill="' + labelColor + '" font-size="11" text-anchor="middle" font-weight="600">' + pt.label + '</text>';
        });

        svg += '</svg>';
        return svg;
      }

      function generateSlaDistributionBars(dist, total) {
        if (!dist || !total || total <= 0) {
          return '<div class="sla-empty-chart-msg">Belum ada data distribusi durasi.</div>';
        }

        var dark = isDarkTheme();
        var trackBg = dark ? '#0f172a' : '#f1f5f9';
        var countColor = dark ? '#94a3b8' : '#64748b';

        var colors = {
          '< 1 Jam': '#10b981',
          '1 - 4 Jam': '#0284c7',
          '4 - 24 Jam': '#f59e0b',
          '1 - 3 Hari': '#ea580c',
          '> 3 Hari': '#ef4444'
        };

        var html = '';
        Object.keys(dist).forEach(function(bucket) {
          var count = dist[bucket] || 0;
          var pct = ((count / total) * 100).toFixed(1);
          var color = colors[bucket] || '#0284c7';

          html += '<div>' +
                  '<div style="display:flex;justify-content:space-between;font-size:12.5px;font-weight:600;margin-bottom:4px;">' +
                    '<span>' + escapeHtml(bucket) + '</span>' +
                    '<span style="color:' + countColor + ';">' + count + ' tiket (' + pct + '%)</span>' +
                  '</div>' +
                  '<div style="width:100%;height:10px;background:' + trackBg + ';border-radius:6px;overflow:hidden;">' +
                    '<div style="width:' + Math.max(pct, count > 0 ? 3 : 0) + '%;height:100%;background:' + color + ';border-radius:6px;transition:width 0.4s ease;"></div>' +
                  '</div>' +
                  '</div>';
        });

        return html;
      }

      function exportSlaCsv() {
        var qParams = [];
        if (_slaFilters.from) qParams.push('from=' + encodeURIComponent(_slaFilters.from));
        if (_slaFilters.to) qParams.push('to=' + encodeURIComponent(_slaFilters.to));
        if (_slaFilters.group_id) qParams.push('group_id=' + encodeURIComponent(_slaFilters.group_id));
        if (_slaFilters.priority_id) qParams.push('priority_id=' + encodeURIComponent(_slaFilters.priority_id));
        qParams.push('per_page=1000');
        var queryStr = '?' + qParams.join('&');

        fetch('/api/v1/sla_reports/tickets' + queryStr, {
          headers: { 'Accept': 'application/json' }
        })
        .then(function(res) { return res.json(); })
        .then(function(res) {
          if (!res || !res.tickets || res.tickets.length === 0) {
            alert('Tidak ada data tiket untuk diexport.');
            return;
          }

          var csvContent = 'Nomor Tiket,Judul Kendala,Customer,Petugas Support,Grup,Prioritas,Waktu Masuk,Waktu Ditutup,Durasi (Menit),Durasi Human\n';
          res.tickets.forEach(function(t) {
            var row = [
              '"' + (t.number || '').replace(/"/g, '""') + '"',
              '"' + (t.title || '').replace(/"/g, '""') + '"',
              '"' + (t.customer_name || '').replace(/"/g, '""') + '"',
              '"' + (t.owner_name || '').replace(/"/g, '""') + '"',
              '"' + (t.group_name || '').replace(/"/g, '""') + '"',
              '"' + (t.priority_name || '').replace(/"/g, '""') + '"',
              '"' + (t.created_at || '').replace(/"/g, '""') + '"',
              '"' + (t.close_at || '').replace(/"/g, '""') + '"',
              t.duration_min || 0,
              '"' + (t.duration_human || '').replace(/"/g, '""') + '"'
            ];
            csvContent += row.join(',') + '\n';
          });

          var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'Laporan_SLA_Durasi_Tiket_' + (new Date().toISOString().slice(0, 10)) + '.csv';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        })
        .catch(function() {
          alert('Gagal mendownload data CSV.');
        });
      }

      function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function patchSpineTicketZoom() {
        if (!window.App || !window.App.TicketZoom || window.App.TicketZoom._slaPatched) return;
        window.App.TicketZoom._slaPatched = true;

        var origRender = window.App.TicketZoom.prototype.render;
        window.App.TicketZoom.prototype.render = function() {
          var res = origRender.apply(this, arguments);
          if (this.ticket_id) {
            var tid = this.ticket_id;
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 10);
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 60);
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 200);
          }
          return res;
        };

        var origShow = window.App.TicketZoom.prototype.show;
        window.App.TicketZoom.prototype.show = function() {
          var res = origShow.apply(this, arguments);
          if (this.ticket_id) {
            var tid = this.ticket_id;
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 10);
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 60);
            setTimeout(function() { enhanceTicketZoomSla(tid); }, 200);
          }
          return res;
        };
      }

      function enhanceDashboardStats() {
        var hash = window.location.hash || '';
        if (hash && hash !== '#' && hash.indexOf('#dashboard') === -1) return;

        var statWidgets = document.querySelector('.dashboard .tab-content.stat-widgets');
        if (!statWidgets) return;

        // 1. Remove Channel Distribution & Ticket Reopen from App.Config so they never register or render
        if (window.App && window.App.Config && typeof window.App.Config.get === 'function') {
          var statsCfg = window.App.Config.get('Stats');
          if (statsCfg) {
            delete statsCfg.ticket_channel_distribution;
            delete statsCfg.ticket_reopen;
          }
        }

        // 2. Hide any unwanted widgets in DOM
        var hideWidgets = document.querySelectorAll('.dashboard .column.ticket_channel_distribution, .dashboard .ticket_channel_distribution, .dashboard .column.ticket_reopen, .dashboard .ticket_reopen');
        for (var c = 0; c < hideWidgets.length; c++) {
          hideWidgets[c].style.setProperty('display', 'none', 'important');
          hideWidgets[c].style.setProperty('visibility', 'hidden', 'important');
          if (hideWidgets[c].parentElement) {
            hideWidgets[c].remove();
          }
        }

        // 3. Retrieve stats data from App.StatsStore
        var storeData = null;
        try {
          if (window.App && window.App.StatsStore && typeof window.App.StatsStore.first === 'function') {
            var store = window.App.StatsStore.first();
            if (store && store.data) {
              storeData = store.data;
            }
          }
        } catch(e) {}

        // Helper to safely set text content without destroying help icon
        function updateCardTitle(cardEl, newTitleText, helpTooltip) {
          if (!cardEl) return;
          var titleEl = cardEl.querySelector('.stat-title');
          if (!titleEl) return;
          var helpEl = titleEl.querySelector('.js-stat-help');
          if (helpEl && helpTooltip) {
            helpEl.setAttribute('title', helpTooltip);
            helpEl.setAttribute('data-original-title', helpTooltip);
          }
          if (titleEl.childNodes && titleEl.childNodes.length > 0) {
            for (var i = 0; i < titleEl.childNodes.length; i++) {
              if (titleEl.childNodes[i].nodeType === Node.TEXT_NODE) {
                titleEl.childNodes[i].nodeValue = newTitleText + ' ';
                return;
              }
            }
          }
        }

        // Card 1: Durasi Tercepat & Terlama (SLA) (.ticket_waiting_time)
        var cardWaiting = document.querySelector('.dashboard .column.ticket_waiting_time');
        if (cardWaiting) {
          updateCardTitle(cardWaiting, 'DURASI TERCEPAT & TERLAMA', 'Durasi penanganan tiket tercepat dan terlama berdasarkan SLA.');
          var wLabel = cardWaiting.querySelector('.stat-label');
          if (wLabel) {
            wLabel.textContent = 'Tercepat: ' + (_realtimeMinDuration || '1 mnt');
          }
          var wDetail = cardWaiting.querySelector('.stat-detail');
          if (wDetail) {
            wDetail.textContent = 'Terlama: ' + (_realtimeMaxDuration || '15 mnt');
          }
          var wAmount = cardWaiting.querySelector('.stat-amount');
          if (wAmount && _realtimeMinMinutes !== null) {
            wAmount.textContent = _realtimeMinMinutes;
          }
        }

        // Card 2: Performa Rating Agen (.ticket_escalation)
        var cardRating = document.querySelector('.dashboard .column.ticket_escalation');
        if (cardRating) {
          updateCardTitle(cardRating, 'PERFORMA RATING AGEN', 'Performa rating kepuasan pelanggan terhadap pelayanan Anda.');
          var escData = storeData ? storeData.StatsTicketEscalation : null;
          var avgRating = (escData && typeof escData.average_rating !== 'undefined') ? Number(escData.average_rating) : (escData && escData.used_for_average ? Number(escData.used_for_average) : 0);
          var totalRatings = (escData && typeof escData.total_ratings !== 'undefined') ? Number(escData.total_ratings) : (escData && escData.total ? Number(escData.total) : 0);

          var rLabel = cardRating.querySelector('.stat-label');
          var rDetail = cardRating.querySelector('.stat-detail');
          if (rLabel) {
            if (totalRatings > 0) {
              rLabel.textContent = 'Rating: ' + avgRating.toFixed(1) + ' ⭐ / 5.0';
            } else {
              rLabel.textContent = 'Belum Ada Penilaian';
            }
          }
          if (rDetail) {
            if (totalRatings > 0) {
              rDetail.textContent = 'Total: ' + totalRatings + ' Ulasan Pelanggan';
            } else {
              rDetail.textContent = '0 Ulasan Pelanggan';
            }
          }
        }

        // Card 3: Total Tiket Masuk (.ticket_load_measure)
        var cardLoad = document.querySelector('.dashboard .column.ticket_load_measure');
        if (cardLoad) {
          updateCardTitle(cardLoad, 'TOTAL TIKET MASUK', 'Jumlah keseluruhan tiket yang masuk ke dalam sistem.');
          var loadData = storeData ? storeData.StatsTicketLoadMeasure : null;
          var totalTickets = (_realtimeTotalTicketCount !== null) ? _realtimeTotalTicketCount : ((loadData && typeof loadData.total !== 'undefined') ? loadData.total : (loadData && typeof loadData.own !== 'undefined' ? loadData.own : 0));
          var lLabel = cardLoad.querySelector('.stat-label');
          var lDetail = cardLoad.querySelector('.stat-detail');
          if (lLabel) {
            lLabel.textContent = 'Total: ' + totalTickets + ' Tiket';
          }
          if (lDetail) {
            lDetail.textContent = 'Seluruh Tiket Masuk Sistem';
          }
        }

        // Card 4: Tiket Dalam Proses (.ticket_in_process)
        var cardInProc = document.querySelector('.dashboard .column.ticket_in_process');
        if (cardInProc) {
          updateCardTitle(cardInProc, 'TIKET DALAM PROSES', 'Jumlah tiket yang saat ini berstatus terbuka dan sedang aktif ditangani.');
          var ipData = storeData ? storeData.StatsTicketInProcess : null;
          var openCount = (_realtimeOpenTicketCount !== null) ? _realtimeOpenTicketCount : ((ipData && typeof ipData.open_count !== 'undefined') ? ipData.open_count : (ipData && typeof ipData.in_process !== 'undefined' ? ipData.in_process : 0));
          var ipLabel = cardInProc.querySelector('.stat-label');
          var ipDetail = cardInProc.querySelector('.stat-detail');
          if (ipLabel) {
            ipLabel.textContent = openCount + ' Tiket Terbuka (Open)';
          }
          if (ipDetail) {
            ipDetail.textContent = 'Tiket Aktif Sedang Ditangani';
          }
        }

        // Real-time fetch: override metrics directly from API (bypass 11-min scheduler delay)
        fetchRealtimeOpenTicketCount();
      }

      // ── Real-time Metrics for Dashboard cards (Open, Total, SLA Durations) ──
      var _openTicketPollInterval = null;
      var _realtimeOpenTicketCount = null;
      var _realtimeTotalTicketCount = null;
      var _realtimeMinDuration = null;
      var _realtimeMaxDuration = null;
      var _realtimeMinMinutes = null;

      function fetchRealtimeOpenTicketCount() {
        // Only run on dashboard page
        var hash = window.location.hash || '';
        if (hash.indexOf('#dashboard') !== 0 && hash !== '' && hash !== '#') return;

        fetch('/api/v1/ticket_open_count', {
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function(res) { return res.ok ? res.json() : null; })
          .then(function(data) {
            if (!data) return;

            // Update Card 1: SLA Durations (Tercepat & Terlama)
            if (typeof data.min_duration_human !== 'undefined') {
              _realtimeMinDuration = data.min_duration_human;
              _realtimeMaxDuration = data.max_duration_human;
              _realtimeMinMinutes = typeof data.min_duration_min !== 'undefined' ? data.min_duration_min : null;
              var cardW = document.querySelector('.dashboard .column.ticket_waiting_time');
              if (cardW) {
                updateCardTitle(cardW, 'DURASI TERCEPAT & TERLAMA', 'Durasi penanganan tiket tercepat dan terlama berdasarkan SLA.');
                var wLbl = cardW.querySelector('.stat-label');
                if (wLbl) wLbl.textContent = 'Tercepat: ' + data.min_duration_human;
                var wDet = cardW.querySelector('.stat-detail');
                if (wDet) wDet.textContent = 'Terlama: ' + (data.max_duration_human || '-');
                var wAmt = cardW.querySelector('.stat-amount');
                if (wAmt && _realtimeMinMinutes !== null) {
                  wAmt.textContent = _realtimeMinMinutes;
                }
              }
            }

            // Update Card 4: Open tickets count
            if (typeof data.open_count !== 'undefined') {
              _realtimeOpenTicketCount = data.open_count;
              var card = document.querySelector('.dashboard .column.ticket_in_process');
              if (card) {
                var lbl = card.querySelector('.stat-label');
                if (lbl) lbl.textContent = data.open_count + ' Tiket Terbuka (Open)';
              }
            }

            // Update Card 3: Total tickets count
            if (typeof data.total_count !== 'undefined') {
              _realtimeTotalTicketCount = data.total_count;
              var cardLoad = document.querySelector('.dashboard .column.ticket_load_measure');
              if (cardLoad) {
                var lLabel = cardLoad.querySelector('.stat-label');
                if (lLabel) lLabel.textContent = 'Total: ' + data.total_count + ' Tiket';
              }
            }

            // Ensure ticket_reopen is removed
            var roCard = document.querySelectorAll('.dashboard .column.ticket_reopen, .dashboard .ticket_reopen');
            roCard.forEach(function(el) { el.remove(); });
          })
          .catch(function() {/* silent fail */});
      }

      function startOpenTicketPolling() {
        if (_openTicketPollInterval) return;
        fetchRealtimeOpenTicketCount();
        _openTicketPollInterval = setInterval(function() {
          var hash = window.location.hash || '';
          // Only poll when on dashboard
          if (hash.indexOf('#dashboard') === 0 || hash === '' || hash === '#') {
            fetchRealtimeOpenTicketCount();
          }
        }, 30000); // refresh every 30 seconds
      }

      function stopOpenTicketPolling() {
        if (_openTicketPollInterval) {
          clearInterval(_openTicketPollInterval);
          _openTicketPollInterval = null;
        }
      }

      function runSlaAndTicketEnhancements() {
        patchSpineTicketZoom();
        enhanceSlaSidebarMenu();
        enhanceSlaReportRoute();
        enhanceReportScreenForSla();
        enhanceTicketZoomSla();
        enhanceDashboardStats();
      }

      document.addEventListener('DOMContentLoaded', function() {
        enhanceView();
        fixTitleAndFavicon();
        enhanceAlerts();
        enhanceRatingSystem();
        runSlaAndTicketEnhancements();
        // Start real-time polling for open ticket count
        setTimeout(startOpenTicketPolling, 1500);
      });

      // Also monitor hashchange and DOM mutations for SLA reporting and ticket zoom
      window.addEventListener('hashchange', function() {
        runSlaAndTicketEnhancements();
        setTimeout(runSlaAndTicketEnhancements, 80);
        setTimeout(runSlaAndTicketEnhancements, 200);
        setTimeout(runSlaAndTicketEnhancements, 450);
        setTimeout(runSlaAndTicketEnhancements, 900);
        setTimeout(runSlaAndTicketEnhancements, 1600);
        // Fetch fresh count when navigating to dashboard
        setTimeout(fetchRealtimeOpenTicketCount, 500);
      });

      var _slaObserverDebounce = null;
      var slaMenuObserver = new MutationObserver(function() {
        if (_slaObserverDebounce) return;
        _slaObserverDebounce = setTimeout(function() {
          _slaObserverDebounce = null;
          runSlaAndTicketEnhancements();
        }, 100);
      });
      slaMenuObserver.observe(document.documentElement, { childList: true, subtree: true });

      // Realtime hooks into Zammad internal SPA events
      function hookZammadRealtimeEvents() {
        if (!window.App) return;

        if (window.App.Event && typeof window.App.Event.bind === 'function') {
          window.App.Event.bind('ui::ticket::shown', function(data) {
            if (data && data.ticket_id) {
              delete _ticketSlaCache[data.ticket_id];
              enhanceTicketZoomSla(data.ticket_id);
              setTimeout(function() { enhanceTicketZoomSla(data.ticket_id); }, 150);
              setTimeout(function() { enhanceTicketZoomSla(data.ticket_id); }, 400);
            }
          });

          window.App.Event.bind('ticket:render', function() {
            runSlaAndTicketEnhancements();
          });

          window.App.Event.bind('app:route:change', function() {
            runSlaAndTicketEnhancements();
          });

          window.App.Event.bind('stats:ready', function() {
            enhanceDashboardStats();
          });

          window.App.Event.bind('dashboard_stats_rebuild', function() {
            setTimeout(enhanceDashboardStats, 100);
          });
        }

        if (window.App.Ticket && typeof window.App.Ticket.bind === 'function') {
          window.App.Ticket.bind('change', function(ticket) {
            if (ticket && ticket.id) {
              delete _ticketSlaCache[ticket.id];
              enhanceTicketZoomSla(ticket.id);
              fetchRealtimeOpenTicketCount();
            }
          });

          window.App.Ticket.bind('create', function(ticket) {
            if (ticket && ticket.id) {
              enhanceTicketZoomSla(ticket.id);
              fetchRealtimeOpenTicketCount();
            }
          });
        }
      }

      setTimeout(hookZammadRealtimeEvents, 1000);
      setTimeout(hookZammadRealtimeEvents, 3000);
    })();
  <% end -%>
  <%= csrf_meta_tags %>
</head>
<body>

  <%= content_for?(:content) ? yield(:content) : yield %>

</body>
</html>
