      function enhanceSlaReportRoute() {
        var hash = window.location.hash || '';
        if (hash !== '#sla_report') {
          var slaCont = document.getElementById('sla-reporting-container');
          if (slaCont) slaCont.style.display = 'none';

          var siblingTasks = document.querySelectorAll('#app > .main, #app > .task, #app > .tabsSidebar-holder');
          siblingTasks.forEach(function(st) {
            st.style.removeProperty('display');
          });

          var contentEl = document.getElementById('content');
          if (contentEl) {
            for (var j = 0; j < contentEl.children.length; j++) {
              var c = contentEl.children[j];
              if (c.id !== 'sla-reporting-container' && c.style.display === 'none') {
                c.style.removeProperty('display');
                c.classList.remove('hide');
