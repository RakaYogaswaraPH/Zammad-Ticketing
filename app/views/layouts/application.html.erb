<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title><%= Setting.get('product_name') %></title>
  <link rel="icon" id="diskominfo-favicon" type="image/png" href="apple-touch-icon.png" />
  <link rel="shortcut icon" id="diskominfo-shortcut-favicon" type="image/png" href="apple-touch-icon.png" />
  <link rel="apple-touch-icon" id="diskominfo-apple-icon" href="apple-touch-icon.png" />
  <%= stylesheet_link_tag "application", :media => 'all' %>
  <%= stylesheet_link_tag "application-print", :media => 'print' %>
  <%= javascript_tag nonce: true do -%>
    if(window.MSInputMethodContext && document.documentMode){
      var polyfillScriptTag = document.createElement('script');
      polyfillScriptTag.setAttribute('src', '<%= path_to_javascript('ie11CustomProperties.min') %>');
      polyfillScriptTag.setAttribute('nonce', '<%= content_security_policy_nonce %>');
      document.head.appendChild(polyfillScriptTag);
    }

    try {
      if(window.matchMedia('(prefers-color-scheme: dark)').matches && localStorage.getItem('theme') != 'light' && !window.location.href.includes('/tests_') ){
        document.documentElement.dataset.theme = 'dark';
      }
    } catch (e) { };
  <% end -%>
  <% if Rails.configuration.assets.debug %>
    <%= javascript_include_tag "application", nonce: true %>
  <% else %>
    <%= javascript_include_tag "application", nonce: true, :defer => 'defer' %>
  <% end %>

  <%# Statically include external files with a nonce here to conform to CSP properly. %>
  <%# Required by form channel configuration preview. %>
  <%= javascript_include_tag "../assets/form/form.js", nonce: true, :defer => 'defer', :skip_pipeline => true, :id => "zammad_form_script"  %>

  <%# Required for browser time mocking in tests. %>
  <% if Rails.env.test? %>
    <%= javascript_include_tag "../assets/tests/sinon-9.2.4.js", nonce: true, :skip_pipeline => true, :id => "zammad_form_script"  %>
  <% end %>

  <style nonce="<%= content_security_policy_nonce %>">
    /* ==========================================================================
       Diskominfo Kabupaten Bandung - Fullscreen Split View Login Theme
       ========================================================================== */

    html,
    body,
    #app,
    #loading-app {
      height: 100% !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
      background-color: #ffffff !important;
    }

    /* Gmail-Style Preloader / Splash Screen */
    .splash,
    .diskominfo-gmail-splash {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      background-color: #ffffff !important;
      background: #ffffff !important;
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1e293b;
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    .splash.diskominfo-splash-fadeout {
      opacity: 0 !important;
      transform: scale(1.03) !important;
      pointer-events: none !important;
    }

    .splash.diskominfo-splash-fadeout .diskominfo-splash-container {
      opacity: 0 !important;
      transform: translateY(-8px) !important;
      transition: opacity 0.35s ease-out, transform 0.35s ease-out !important;
    }

    .splash[style*="display: none"],
    .splash.is-hidden {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    .diskominfo-splash-container {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      max-width: 360px !important;
      width: 100% !important;
      padding: 24px !important;
      box-sizing: border-box !important;
    }

    .diskominfo-splash-logo-wrapper {
      margin-bottom: 24px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .diskominfo-splash-logo {
      height: 76px !important;
      width: auto !important;
      object-fit: contain !important;
      filter: drop-shadow(0 4px 12px rgba(11, 94, 215, 0.15)) !important;
      animation: diskominfoLogoPulse 2s ease-in-out infinite !important;
    }

    @keyframes diskominfoLogoPulse {
      0%, 100% {
        transform: scale(1);
        opacity: 0.95;
      }
      50% {
        transform: scale(1.04);
        opacity: 1;
      }
    }

    .diskominfo-splash-title {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: #0f172a !important;
      letter-spacing: -0.4px !important;
      margin-bottom: 4px !important;
    }

    .diskominfo-splash-sub {
      font-size: 13.5px !important;
      font-weight: 500 !important;
      color: #64748b !important;
      margin-bottom: 32px !important;
    }

    .diskominfo-splash-progress-track {
      width: 100% !important;
      max-width: 260px !important;
      height: 8px !important;
      background-color: #e2e8f0 !important;
      border-radius: 9999px !important;
      overflow: hidden !important;
      position: relative !important;
      margin-bottom: 14px !important;
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.08) !important;
    }

    .diskominfo-splash-progress-bar {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      height: 100% !important;
      background: linear-gradient(90deg, #092c5e, #0b5ed7) !important;
      background-color: #092c5e !important;
      border-radius: 9999px !important;
      transition: width 0.15s ease-out !important;
    }

    .diskominfo-splash-loading-text {
      font-size: 13.5px !important;
      font-weight: 500 !important;
      color: #64748b !important;
      letter-spacing: 0.2px !important;
    }

    #diskominfo-progress-percent {
      font-weight: 700 !important;
      color: #0b5ed7 !important;
      margin-left: 4px !important;
    }

    .login.fullscreen,
    .signup.fullscreen,
    .reset_password.fullscreen {
      background: #ffffff !important;
      color: #334155 !important;
      display: flex !important;
      flex-direction: row !important;
      width: 100vw !important;
      height: 100vh !important;
      min-height: 100vh !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }

    .login .fullscreen-center,
    .login .fullscreen-body,
    .signup .fullscreen-center,
    .signup .fullscreen-body,
    .reset_password .fullscreen-center,
    .reset_password .fullscreen-body {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      flex-direction: row !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
    }

    .login .fullscreen-body > p,
    .signup .fullscreen-body > p,
    .reset_password .fullscreen-body > p {
      display: none !important;
    }

    .login .hero-unit,
    .signup .hero-unit,
    .reset_password .hero-unit {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
      display: flex !important;
      flex-direction: row !important;
    }

    /* Left Hero Section (50% Fullscreen Banner & Quotes - Call Center Theme) */
    .diskominfo-hero-section {
      flex: 0 0 50% !important;
      width: 50% !important;
      height: 100vh !important;
      min-height: 100vh !important;
      position: relative !important;
      border-radius: 0 !important;
      overflow: hidden !important;
      background: url('https://images.unsplash.com/photo-1549923746-c502d488b3ea?auto=format&fit=crop&w=1400&q=80') center center / cover no-repeat !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      padding: 48px !important;
      color: #ffffff !important;
      box-sizing: border-box !important;
    }

    .diskominfo-hero-overlay {
      position: absolute !important;
      inset: 0 !important;
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(15, 23, 42, 0.2) 40%, rgba(15, 23, 42, 0.9) 100%) !important;
      z-index: 1 !important;
    }

    .diskominfo-hero-header {
      position: relative !important;
      z-index: 2 !important;
      display: flex !important;
      align-items: center !important;
      gap: 14px !important;
    }

    .diskominfo-hero-logo {
      height: 44px !important;
      width: auto !important;
      max-width: 160px !important;
      object-fit: contain !important;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4)) !important;
    }

    .diskominfo-hero-title-group {
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
    }

    .diskominfo-hero-brand-name {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: #ffffff !important;
      letter-spacing: -0.3px !important;
      line-height: 1.15 !important;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5) !important;
    }

    .diskominfo-hero-brand-sub {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: rgba(255, 255, 255, 0.9) !important;
      letter-spacing: 0.2px !important;
      line-height: 1.2 !important;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5) !important;
      margin-top: 2px !important;
    }

    .diskominfo-hero-footer {
      position: relative !important;
      z-index: 2 !important;
      max-width: 520px !important;
    }

    .diskominfo-hero-quote {
      font-size: 22px !important;
      font-weight: 600 !important;
      line-height: 1.45 !important;
      color: #ffffff !important;
      margin: 0 0 16px 0 !important;
      padding: 0 !important;
      border: none !important;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5) !important;
      font-style: normal !important;
    }

    .diskominfo-quote-author {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: #ffffff !important;
      letter-spacing: 0.1px !important;
    }

    .diskominfo-quote-dept {
      font-size: 14px !important;
      font-weight: 400 !important;
      color: rgba(255, 255, 255, 0.85) !important;
    }

    /* Right Form Section (50% Fullscreen Form Container) */
    .diskominfo-form-section {
      flex: 0 0 50% !important;
      width: 50% !important;
      height: 100vh !important;
      min-height: 100vh !important;
      background: #ffffff !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: 48px 32px !important;
      box-sizing: border-box !important;
      overflow-y: auto !important;
    }

    /* Smooth View Transition Animations */
    @keyframes diskominfoCardSlideIn {
      0% {
        opacity: 0;
        transform: translateY(16px) scale(0.985);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes diskominfoCardSlideOut {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(-12px) scale(0.985);
      }
    }

    .diskominfo-form-inner-wrapper {
      width: 100% !important;
      max-width: 440px !important;
      margin: auto !important;
      display: flex !important;
      flex-direction: column !important;
      text-align: center !important;
      align-items: center !important;
      animation: diskominfoCardSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      will-change: opacity, transform !important;
    }

    .diskominfo-form-inner-wrapper.is-navigating-out,
    .diskominfo-reset-success-card.is-navigating-out {
      animation: diskominfoCardSlideOut 0.14s cubic-bezier(0.4, 0, 1, 1) forwards !important;
      pointer-events: none !important;
    }

    .diskominfo-form-header {
      margin-bottom: 32px !important;
      text-align: center !important;
      width: 100% !important;
    }

    .diskominfo-main-title {
      font-size: 32px !important;
      font-weight: 800 !important;
      color: #0f172a !important;
      margin: 0 0 8px 0 !important;
      letter-spacing: -0.6px !important;
      line-height: 1.2 !important;
      text-align: center !important;
    }

    .diskominfo-main-subtitle {
      font-size: 14px !important;
      color: #64748b !important;
      margin: 0 auto !important;
      max-width: 380px !important;
      line-height: 1.5 !important;
      text-align: center !important;
    }

    /* Form Groups & Inputs */
    .diskominfo-form-content {
      width: 100% !important;
    }

    .diskominfo-form-content .form-group {
      margin-bottom: 18px !important;
      text-align: left !important;
    }

    .diskominfo-form-content .formGroup-label label {
      color: #334155 !important;
      font-weight: 700 !important;
      font-size: 12px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.6px !important;
      margin-bottom: 6px !important;
      display: block !important;
      text-align: left !important;
    }

    .diskominfo-form-content .form-control {
      width: 100% !important;
      height: 48px !important;
      background-color: #f8fafc !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #0f172a !important;
      border-radius: 10px !important;
      padding: 0 16px !important;
      font-size: 14px !important;
      box-sizing: border-box !important;
      transition: all 0.2s ease-in-out !important;
    }

    .diskominfo-form-content .form-control:focus {
      background-color: #ffffff !important;
      border-color: #0b5ed7 !important;
      box-shadow: 0 0 0 3.5px rgba(11, 94, 215, 0.15) !important;
      outline: none !important;
    }

    /* Inline Actions (Remember Me & Forgot Password) */
    .form-group--inline-actions {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      margin: 12px 0 24px 0 !important;
    }

    .checkbox-replacement {
      display: inline-flex !important;
      align-items: center !important;
      gap: 8px !important;
      color: #475569 !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      cursor: pointer !important;
      user-select: none !important;
      margin: 0 !important;
      position: relative !important;
      transition: color 0.15s ease-in-out !important;
    }

    .checkbox-replacement:hover {
      color: #0b5ed7 !important;
    }

    .checkbox-replacement input[type="checkbox"] {
      position: absolute !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      margin: 0 !important;
      pointer-events: none !important;
    }

    /* Hide Zammad SVGs inside checkbox-replacement */
    .checkbox-replacement .icon,
    .checkbox-replacement svg:not(.custom-check-svg) {
      display: none !important;
    }

    /* Checkbox Box (Unchecked) */
    .checkbox-replacement .checkbox-box {
      width: 18px !important;
      height: 18px !important;
      border: 1.5px solid #cbd5e1 !important;
      border-radius: 4px !important;
      background-color: #ffffff !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      transition: all 0.15s ease-in-out !important;
      flex-shrink: 0 !important;
      box-sizing: border-box !important;
    }

    /* Hover state */
    .checkbox-replacement:hover .checkbox-box {
      border-color: #0b5ed7 !important;
    }

    /* White checkmark inside the checkbox box using CSS ::after */
    .checkbox-replacement .checkbox-box::after {
      content: "" !important;
      width: 4px !important;
      height: 8px !important;
      border: solid #ffffff !important;
      border-width: 0 2px 2px 0 !important;
      transform: rotate(45deg) scale(0) !important;
      position: absolute !important;
      top: 1.5px !important;
      left: 5px !important;
      opacity: 0 !important;
      transition: transform 0.15s ease-in-out, opacity 0.15s ease-in-out !important;
    }

    /* Checked State */
    .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box {
      background-color: #0b5ed7 !important;
      border-color: #0b5ed7 !important;
    }

    .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box::after {
      opacity: 1 !important;
      transform: rotate(45deg) scale(1) !important;
    }

    /* Label text turns blue when checked */
    .checkbox-replacement input[type="checkbox"]:checked ~ .label-text {
      color: #0b5ed7 !important;
      font-weight: 600 !important;
    }

    .diskominfo-forgot-password-link {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #0b5ed7 !important;
      text-decoration: none !important;
      transition: color 0.15s !important;
    }

    .diskominfo-forgot-password-link:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    /* Alert & Error Animation */
    @keyframes diskominfoAlertSlideDown {
      0% {
        opacity: 0;
        transform: translateY(-10px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .alert,
    .alert--danger,
    .alert-danger {
      background-color: #ef4444 !important;
      color: #ffffff !important;
      border: none !important;
      border-radius: 10px !important;
      padding: 14px 18px !important;
      font-size: 13.5px !important;
      font-weight: 500 !important;
      line-height: 1.5 !important;
      text-align: center !important;
      box-shadow: 0 4px 14px rgba(239, 68, 68, 0.2) !important;
      animation: diskominfoAlertSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      margin-bottom: 20px !important;
    }

    /* Submit Button */
    .btn--diskominfo-submit {
      width: 100% !important;
      height: 48px !important;
      background-color: #0b5ed7 !important;
      border: none !important;
      border-radius: 10px !important;
      color: #ffffff !important;
      font-weight: 700 !important;
      font-size: 16px !important;
      letter-spacing: 0.3px !important;
      box-shadow: 0 4px 14px rgba(11, 94, 215, 0.3) !important;
      cursor: pointer !important;
      transition: background-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .btn--diskominfo-submit:hover {
      background-color: #094bac !important;
      box-shadow: 0 4px 14px rgba(11, 94, 215, 0.3) !important;
      transform: none !important;
    }

    .btn--diskominfo-submit:active {
      background-color: #083b87 !important;
      transform: none !important;
    }

    /* Footer Section - Center Aligned */
    .diskominfo-footer-section {
      margin-top: 28px !important;
      text-align: center !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .diskominfo-support-info {
      color: #64748b !important;
      font-size: 13px !important;
      line-height: 1.6 !important;
      margin: 0 auto 16px auto !important;
      max-width: 400px !important;
      text-align: center !important;
      display: block !important;
    }

    .diskominfo-support-info p {
      margin: 0 0 6px 0 !important;
      text-align: center !important;
      color: #64748b !important;
    }

    .diskominfo-link,
    .diskominfo-support-info a {
      color: #0b5ed7 !important;
      font-weight: 600 !important;
      text-decoration: none !important;
      display: block !important;
      margin-top: 4px !important;
      text-align: center !important;
    }

    .diskominfo-link:hover,
    .diskominfo-support-info a:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    .diskominfo-register-row {
      margin-top: 16px !important;
      padding-top: 16px !important;
      border-top: 1px solid #f1f5f9 !important;
      font-size: 13px !important;
      color: #475569 !important;
      text-align: center !important;
      width: 100% !important;
    }

    .diskominfo-register-prompt {
      margin-right: 4px !important;
    }

    .diskominfo-register-link {
      color: #0b5ed7 !important;
      font-weight: 700 !important;
      text-decoration: none !important;
    }

    .diskominfo-register-link:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    .diskominfo-mobile-switch {
      margin-top: 12px !important;
      font-size: 12px !important;
      text-align: center !important;
    }

    .diskominfo-mobile-switch a {
      color: #94a3b8 !important;
      text-decoration: none !important;
    }

    .diskominfo-mobile-switch a:hover {
      color: #64748b !important;
    }

    .poweredBy,
    .diskominfo-powered-by,
    .login .auth-providers,
    .login .separator {
      display: none !important;
    }

    /* Password Reset Success Confirmation Card */
    .diskominfo-reset-success-card {
      text-align: center !important;
      width: 100% !important;
      max-width: 420px !important;
      margin: auto !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      padding: 8px 0 !important;
      animation: diskominfoCardSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      will-change: opacity, transform !important;
    }

    .diskominfo-reset-success-icon-wrap {
      width: 76px !important;
      height: 76px !important;
      background: rgba(11, 94, 215, 0.09) !important;
      border-radius: 50% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin: 0 auto 24px auto !important;
      color: #0b5ed7 !important;
    }

    .diskominfo-reset-success-title {
      font-size: 28px !important;
      font-weight: 800 !important;
      color: #0f172a !important;
      margin: 0 0 16px 0 !important;
      letter-spacing: -0.5px !important;
      text-align: center !important;
    }

    .diskominfo-reset-success-desc {
      font-size: 14.5px !important;
      color: #475569 !important;
      line-height: 1.65 !important;
      margin: 0 auto 32px auto !important;
      max-width: 380px !important;
      text-align: center !important;
    }

    .diskominfo-reset-success-btn {
      width: 100% !important;
      height: 48px !important;
      margin-bottom: 20px !important;
    }

    .diskominfo-reset-retry-wrap {
      margin-top: 12px !important;
      text-align: center !important;
    }

    .diskominfo-reset-retry-link {
      color: #0b5ed7 !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      text-decoration: none !important;
      cursor: pointer !important;
      transition: color 0.15s ease-in-out !important;
    }

    .diskominfo-reset-retry-link:hover {
      color: #094bac !important;
      text-decoration: underline !important;
    }

    /* Responsive Adaptations */
    @media (max-width: 900px) {
      html,
      body,
      #app {
        overflow-y: auto !important;
      }

      .login.fullscreen {
        flex-direction: column !important;
        height: auto !important;
        min-height: 100vh !important;
        overflow-y: auto !important;
      }

      .login .fullscreen-center,
      .login .fullscreen-body,
      .login .hero-unit {
        flex-direction: column !important;
        height: auto !important;
        min-height: auto !important;
      }

      .diskominfo-hero-section {
        flex: none !important;
        width: 100% !important;
        height: auto !important;
        min-height: 240px !important;
        padding: 28px 24px !important;
      }

      .diskominfo-hero-quote {
        font-size: 17px !important;
        margin-bottom: 8px !important;
      }

      .diskominfo-quote-author {
        font-size: 14px !important;
      }

      .diskominfo-quote-dept {
        font-size: 12px !important;
      }

      .diskominfo-form-section {
        flex: none !important;
        width: 100% !important;
        height: auto !important;
        min-height: auto !important;
        padding: 36px 20px !important;
      }

      .diskominfo-main-title {
        font-size: 26px !important;
      }

      .diskominfo-main-subtitle {
        font-size: 13px !important;
      }
    }

    /* Back Button */
    .diskominfo-back-wrapper {
      margin-top: 16px !important;
      width: 100% !important;
      text-align: center !important;
    }

    .diskominfo-back-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      background: none !important;
      border: none !important;
      color: #64748b !important;
      font-size: 13px !important;
      font-weight: 600 !important;
      cursor: pointer !important;
      padding: 6px 0 !important;
      transition: color 0.15s !important;
      box-shadow: none !important;
    }

    .diskominfo-back-btn:hover {
      color: #0b5ed7 !important;
      background: none !important;
      box-shadow: none !important;
    }

    /* Prevent Zammad dark flash on signup/password_reset routes */
    body {
      background: #ffffff !important;
    }

    .login .hero-unit {
      background: #ffffff !important;
      color: #334155 !important;
      box-shadow: none !important;
      border: none !important;
    }

    /* Signup form - handle side-by-side name fields */
    .diskominfo-form-content .row {
      display: flex !important;
      gap: 12px !important;
      margin-bottom: 0 !important;
    }

    .diskominfo-form-content .row > [class*="col-"] {
      flex: 1 !important;
      min-width: 0 !important;
    }

    @media (max-width: 600px) {
      .diskominfo-form-content .row {
        flex-direction: column !important;
        gap: 0 !important;
      }
    }
  </style>

  <%= javascript_tag nonce: true do -%>
    (function() {
      var logoUrlCache = '/api/v1/system_assets/product_logo/<%= Setting.get("product_logo") %>';

      /* ── Helpers ─────────────────────────────────────────── */

      function getHash() {
        return (window.location.hash || '#login').replace(/^#\/?/, '') || 'login';
      }

      function buildHeroSection() {
        var el = document.createElement('div');
        el.className = 'diskominfo-hero-section';
        el.innerHTML =
          '<div class="diskominfo-hero-overlay"></div>' +
          '<div class="diskominfo-hero-header">' +
            (logoUrlCache ? '<img class="diskominfo-hero-logo" src="' + logoUrlCache + '" alt="Diskominfo">' : '') +
            '<div class="diskominfo-hero-title-group">' +
              '<span class="diskominfo-hero-brand-name">Diskominfo</span>' +
              '<span class="diskominfo-hero-brand-sub">Kabupaten Bandung</span>' +
            '</div>' +
          '</div>' +
          '<div class="diskominfo-hero-footer">' +
            '<blockquote class="diskominfo-hero-quote">' +
              '\u201cPelayanan responsif, cepat, dan transparan untuk seluruh kebutuhan teknologi informasi Anda.\u201d' +
            '</blockquote>' +
            '<div class="diskominfo-quote-author">IT Helpdesk Diskominfo</div>' +
            '<div class="diskominfo-quote-dept">Pemerintah Kabupaten Bandung</div>' +
          '</div>';
        return el;
      }

      function buildFormSection() {
        var el = document.createElement('div');
        el.className = 'diskominfo-form-section';
        return el;
      }

      function buildInnerWrapper() {
        var el = document.createElement('div');
        el.className = 'diskominfo-form-inner-wrapper';
        return el;
      }

      function buildBackButton() {
        var btn = document.createElement('a');
        btn.href = '#login';
        btn.className = 'diskominfo-back-btn';
        btn.style.cssText = 'display:inline-flex;align-items:center;justify-content:center;gap:6px;background:transparent;background-color:transparent;border:none;color:#64748b;font-size:13.5px;font-weight:600;text-decoration:none;cursor:pointer;padding:8px 14px;border-radius:8px;transition:all 0.15s ease-in-out;outline:none;box-shadow:none;';
        btn.innerHTML =
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="15 18 9 12 15 6"/></svg>' +
          '<span>Kembali ke Login</span>';
        btn.onmouseover = function() { btn.style.color = '#0b5ed7'; btn.style.backgroundColor = '#f1f5f9'; };
        btn.onmouseout = function() { btn.style.color = '#64748b'; btn.style.backgroundColor = 'transparent'; };
        var wrap = document.createElement('div');
        wrap.className = 'diskominfo-back-wrapper';
        wrap.style.cssText = 'margin-top:20px;width:100%;text-align:center;display:flex;justify-content:center;';
        wrap.appendChild(btn);
        return wrap;
      }

      function attachSmoothNavLinks(container) {
        var links = container.querySelectorAll('a[href^="#"]');
        links.forEach(function(link) {
          if (link.dataset.smoothNav === '1') return;
          link.dataset.smoothNav = '1';
          link.addEventListener('click', function(e) {
            var targetHash = link.getAttribute('href');
            if (!targetHash) return;
            var cleanTarget = targetHash.replace(/^#\/?/, '') || 'login';
            var currentClean = (window.location.hash || '#login').replace(/^#\/?/, '') || 'login';
            if (cleanTarget === currentClean) return;
            e.preventDefault();

            var formSec = container.querySelector('.diskominfo-form-section') || container;
            var inner = formSec.querySelector('.diskominfo-form-inner-wrapper') || formSec.querySelector('.diskominfo-reset-success-card') || formSec;
            if (inner) {
              inner.classList.add('is-navigating-out');
              setTimeout(function() {
                window.location.hash = cleanTarget;
              }, 120);
            } else {
              window.location.hash = cleanTarget;
            }
          });
        });
      }

      function mountSplitScreen(loginRoot, innerPopulateFn) {
        var heroSection  = buildHeroSection();
        var formSection  = buildFormSection();
        var formInner    = buildInnerWrapper();
        innerPopulateFn(formInner);
        formSection.appendChild(formInner);
        loginRoot.innerHTML = '';
        loginRoot.appendChild(heroSection);
        loginRoot.appendChild(formSection);
        attachSmoothNavLinks(loginRoot);
        document.querySelectorAll('.poweredBy, .diskominfo-powered-by').forEach(function(e) { e.remove(); });
      }

      /* ── Login view ──────────────────────────────────────── */

      function enhanceLogin(loginRoot, heroUnit) {
        var logoImg = heroUnit.querySelector('.company-logo') || heroUnit.querySelector('.diskominfo-hero-logo');
        if (logoImg && logoImg.getAttribute('src')) logoUrlCache = logoImg.getAttribute('src');

        var form = heroUnit.querySelector('form#login');
        if (!form) return false;

        // Auto-login handling if redirected from signup
        var autoCredsRaw = null;
        try { autoCredsRaw = sessionStorage.getItem('_dk_au'); } catch(e) {}
        if (autoCredsRaw) {
          try {
            var autoCreds = JSON.parse(autoCredsRaw);
            sessionStorage.removeItem('_dk_au');
            if (autoCreds && autoCreds.e && autoCreds.p) {
              var userEl = form.querySelector('#username') || form.querySelector('input[name="username"]');
              var pwEl   = form.querySelector('#password') || form.querySelector('input[name="password"]');
              if (userEl && pwEl) {
                userEl.value = autoCreds.e;
                pwEl.value   = autoCreds.p;
                userEl.dispatchEvent(new Event('input', { bubbles: true }));
                userEl.dispatchEvent(new Event('change', { bubbles: true }));
                pwEl.dispatchEvent(new Event('input', { bubbles: true }));
                pwEl.dispatchEvent(new Event('change', { bubbles: true }));

                setTimeout(function() {
                  var sBtn = form.querySelector('button[type="submit"]');
                  if (sBtn) {
                    sBtn.click();
                  }
                }, 150);
              }
            }
          } catch(ex) {}
        }

        var el;
        el = form.querySelector('label[for="username"]');                                    if (el) el.textContent = 'Username / Email';
        el = form.querySelector('#username');                                                 if (el) el.placeholder = 'Masukkan username atau email';
        el = form.querySelector('label[for="password"]');                                    if (el) el.textContent = 'Kata Sandi';
        el = form.querySelector('#password');                                                 if (el) el.placeholder = '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022';
        var cbRepl = form.querySelector('.checkbox-replacement');
        if (cbRepl) {
          var labelTxt = cbRepl.querySelector('.label-text');
          if (labelTxt) labelTxt.textContent = 'Ingat saya';
          cbRepl.querySelectorAll('.custom-checkbox-box, .icon').forEach(function(e) { e.remove(); });
          if (!cbRepl.querySelector('.checkbox-box')) {
            var boxSpan = document.createElement('span');
            boxSpan.className = 'checkbox-box';
            var inp = cbRepl.querySelector('input[type="checkbox"]');
            if (inp && inp.nextSibling) {
              cbRepl.insertBefore(boxSpan, inp.nextSibling);
            } else {
              cbRepl.appendChild(boxSpan);
            }
          }
        }

        var forgotLink = form.querySelector('a[href="#password_reset"]') || form.querySelector('.btn--secondary');
        if (forgotLink) { forgotLink.textContent = 'Lupa kata sandi?'; forgotLink.className = 'diskominfo-forgot-password-link'; }

        var rememberGroup = form.querySelector('.checkbox-replacement') ? form.querySelector('.checkbox-replacement').closest('.form-group') : null;
        if (rememberGroup) {
          rememberGroup.classList.add('form-group--inline-actions');
          if (forgotLink && forgotLink.parentNode !== rememberGroup) rememberGroup.appendChild(forgotLink);
        }

        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.textContent = 'Masuk';
          submitBtn.className = 'btn btn--primary btn--diskominfo-submit';

          // ── Login button loading state ─────────────────────────
          form.addEventListener('submit', function() {
            var btn = form.querySelector('button[type="submit"]');
            if (!btn || btn.dataset.loading === '1') return;
            btn.dataset.loading = '1';

            var pct = 0;
            var pctSpan = document.createElement('span');
            pctSpan.style.cssText = 'margin-left:8px;font-size:13px;font-weight:600;opacity:0.9;';
            pctSpan.textContent = '0%';

            btn.textContent = '';

            // Spinner SVG
            var spinner = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            spinner.setAttribute('width', '18');
            spinner.setAttribute('height', '18');
            spinner.setAttribute('viewBox', '0 0 24 24');
            spinner.setAttribute('fill', 'none');
            spinner.setAttribute('stroke', 'currentColor');
            spinner.setAttribute('stroke-width', '2.5');
            spinner.style.cssText = 'animation:dkSpin 0.7s linear infinite;flex-shrink:0;';
            var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', '12'); circle.setAttribute('cy', '12'); circle.setAttribute('r', '10');
            circle.setAttribute('stroke-dasharray', '31.4'); circle.setAttribute('stroke-dashoffset', '10');
            circle.setAttribute('stroke-opacity', '0.3');
            var arc = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            arc.setAttribute('d', 'M12 2 a10 10 0 0 1 7.07 2.93');
            arc.setAttribute('stroke', 'currentColor');
            spinner.appendChild(circle);
            spinner.appendChild(arc);

            var label = document.createElement('span');
            label.textContent = 'Sedang masuk...';
            label.style.cssText = 'margin-left:8px;';

            btn.appendChild(spinner);
            btn.appendChild(label);
            btn.appendChild(pctSpan);
            btn.disabled = false; // let Zammad's formDisable handle it

            var loginTimer = setInterval(function() {
              if (pct < 88) {
                pct += Math.floor(Math.random() * 6) + 2;
                if (pct > 88) pct = 88;
                pctSpan.textContent = pct + '%';
              }
            }, 120);

            // Watch for error alert or form re-render (reset button)
            var resetObserver = new MutationObserver(function() {
              var alert = document.querySelector('.alert--danger, .alert-danger');
              if (alert) {
                clearInterval(loginTimer);
                resetObserver.disconnect();
                btn.dataset.loading = '0';
                btn.disabled = false;
                btn.textContent = 'Masuk';
                btn.className = 'btn btn--primary btn--diskominfo-submit';
              }
            });
            resetObserver.observe(document.body, { childList: true, subtree: true });
          });
        }

        attachPasswordToggles(form);

        heroUnit.querySelectorAll('.auth-providers, .separator').forEach(function(e) { e.remove(); });

        var formBodyEl = document.createElement('div');
        formBodyEl.className = 'diskominfo-form-content';
        formBodyEl.appendChild(form);

        mountSplitScreen(loginRoot, function(inner) {
          var hdr = document.createElement('div');
          hdr.className = 'diskominfo-form-header';
          hdr.innerHTML =
            '<h1 class="diskominfo-main-title">Selamat Datang</h1>' +
            '<p class="diskominfo-main-subtitle">Layanan Bantuan Teknologi Informasi Diskominfo Kabupaten Bandung</p>';
          inner.appendChild(hdr);

          inner.appendChild(formBodyEl);

          var footer = document.createElement('div');
          footer.className = 'js-footer diskominfo-footer-section';
          footer.innerHTML =
            '<div class="diskominfo-support-info" style="text-align:center;margin:0 auto 16px auto;max-width:400px;display:block;color:#64748b;font-size:13px;line-height:1.6;">' +
              '<span style="display:block;text-align:center;">Sudah terdaftar dengan alamat email jika pernah menghubungi tim Support kami.</span>' +
              '<a href="#password_reset" class="diskominfo-link" style="display:block;text-align:center;margin-top:4px;color:#0b5ed7;font-weight:600;text-decoration:none;">Anda dapat meminta kata sandi baru di sini.</a>' +
            '</div>' +
            '<div class="diskominfo-register-row">' +
              '<span class="diskominfo-register-prompt">Belum memiliki akun?</span>' +
              '<a href="#signup" class="diskominfo-register-link">Daftar sebagai pengguna baru</a>' +
            '</div>';
          inner.appendChild(footer);
        });
        return true;
      }

      function attachPasswordToggles(form) {
        if (!form) return;
        var inputs = form.querySelectorAll('input[type="password"], input[data-is-pw="1"]');
        inputs.forEach(function(inp) {
          if (inp.dataset.pwToggleAttached === '1') return;
          inp.dataset.pwToggleAttached = '1';
          inp.dataset.isPw = '1';

          var wrapper = document.createElement('div');
          wrapper.className = 'diskominfo-pw-input-wrapper';
          wrapper.style.cssText = 'position:relative;display:block;width:100%;margin:0;padding:0;';
          if (inp.parentNode) {
            inp.parentNode.insertBefore(wrapper, inp);
            wrapper.appendChild(inp);
          }

          inp.style.paddingRight = '42px';
          inp.style.boxSizing = 'border-box';

          var toggleBtn = document.createElement('button');
          toggleBtn.type = 'button';
          toggleBtn.className = 'diskominfo-pw-toggle-btn';
          toggleBtn.setAttribute('aria-label', 'Lihat kata sandi');
          toggleBtn.style.cssText = 'position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#64748b;padding:4px;display:flex;align-items:center;justify-content:center;z-index:10;border-radius:4px;outline:none;line-height:1;height:28px;width:28px;';

          var eyeIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
          var eyeOffIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

          toggleBtn.innerHTML = eyeIcon;

          toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (inp.type === 'password') {
              inp.type = 'text';
              toggleBtn.innerHTML = eyeOffIcon;
              toggleBtn.style.color = '#0b5ed7';
            } else {
              inp.type = 'password';
              toggleBtn.innerHTML = eyeIcon;
              toggleBtn.style.color = '#64748b';
            }
          });

          wrapper.appendChild(toggleBtn);
        });
      }

      /* ── Signup view ─────────────────────────────────────── */

      function enhanceSignup(loginRoot, heroUnit) {
        var logoImg = heroUnit.querySelector('.company-logo') || heroUnit.querySelector('.diskominfo-hero-logo');
        if (logoImg && logoImg.getAttribute('src')) logoUrlCache = logoImg.getAttribute('src');

        // ── Detect post-signup "verify email" state ──────────────
        // After signup succeeds, Zammad renders signup/verify.jst.eco which has
        // .js-submitResend button but NO form#signup — show success card instead.
        var isVerifyState = !heroUnit.querySelector('form#signup') &&
                            (heroUnit.querySelector('.js-submitResend') ||
                             heroUnit.textContent.toLowerCase().includes('pendaftaran berhasil') ||
                             heroUnit.textContent.toLowerCase().includes('registration successful') ||
                             heroUnit.textContent.toLowerCase().includes('verifikasi'));

        if (isVerifyState) {
          mountSplitScreen(loginRoot, function(inner) {
            var card = document.createElement('div');
            card.className = 'diskominfo-reset-success-card';
            card.style.cssText = 'animation: diskominfoCardSlideIn 0.35s cubic-bezier(0.16,1,0.3,1) both;';
            card.innerHTML =
              '<div class="diskominfo-reset-success-icon-wrap">' +
                '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0b5ed7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                  '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>' +
                  '<polyline points="22 4 12 14.01 9 11.01"></polyline>' +
                '</svg>' +
              '</div>' +
              '<h1 class="diskominfo-reset-success-title">Pendaftaran Berhasil!</h1>' +
              '<p class="diskominfo-reset-success-desc">' +
                'Akun Anda telah berhasil dibuat. Klik tombol di bawah untuk langsung masuk.' +
              '</p>';

            var loginBtn = document.createElement('button');
            loginBtn.type = 'button';
            loginBtn.textContent = 'Masuk Sekarang';
            loginBtn.className = 'btn btn--primary btn--diskominfo-submit';
            loginBtn.style.cssText = 'display:block;width:100%;text-align:center;margin-top:16px;padding:12px 0;cursor:pointer;';
            loginBtn.addEventListener('click', function() {
              loginBtn.disabled = true;
              loginBtn.textContent = 'Sedang masuk...';
              window.location.hash = '#login';
            });
            card.appendChild(loginBtn);

            inner.appendChild(card);
          });
          return true;
        }

        // ── Normal signup form state ──────────────────────────────
        var form = heroUnit.querySelector('form#signup') || heroUnit.querySelector('form');
        if (!form) return false;

        // Translate labels
        form.querySelectorAll('label').forEach(function(lbl) {
          var f = (lbl.getAttribute('for') || '').toLowerCase();
          var t = lbl.textContent.trim().toLowerCase();
          if      (f.includes('firstname')        || t === 'first name')               lbl.textContent = 'Nama Depan';
          else if (f.includes('lastname')         || t === 'last name')                lbl.textContent = 'Nama Belakang';
          else if (f.includes('email')            || t === 'email')                    lbl.textContent = 'Alamat Email *';
          else if (f.includes('password_confirm') || t.includes('confirm'))            lbl.textContent = 'Konfirmasi Kata Sandi *';
          else if (f.includes('password')         || t === 'password')                 lbl.textContent = 'Kata Sandi *';
        });

        // Translate placeholders
        form.querySelectorAll('input').forEach(function(inp) {
          var n = (inp.getAttribute('name') || inp.getAttribute('id') || '').toLowerCase();
          if      (n.includes('firstname'))        inp.placeholder = 'Nama depan';
          else if (n.includes('lastname'))         inp.placeholder = 'Nama belakang';
          else if (n.includes('email'))            inp.placeholder = 'email@example.com';
          else if (n.includes('password_confirm')) inp.placeholder = 'Ulangi kata sandi';
          else if (n.includes('password'))         inp.placeholder = 'Minimal 10 karakter';
        });

        attachPasswordToggles(form);

        // Capture credentials for auto-login after signup succeeds
        var emailInp = form.querySelector('input[name="email"]') || form.querySelector('input[type="email"]');
        var pwInp    = form.querySelector('input[name="password"]');
        if (emailInp && pwInp) {
          form.addEventListener('submit', function() {
            try {
              sessionStorage.setItem('_dk_au', JSON.stringify({ e: emailInp.value, p: pwInp.value }));
            } catch(ex) {}
          }, true);
        }

        var submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.btn--primary');
        if (submitBtn) { submitBtn.textContent = 'Buat Akun'; submitBtn.className = 'btn btn--primary btn--diskominfo-submit'; }

        // Remove Zammad cancel link — we use our own back button
        form.querySelectorAll('a[href="#login"], a.btn--secondary').forEach(function(l) { l.remove(); });

        var formBodyEl = document.createElement('div');
        formBodyEl.className = 'diskominfo-form-content';
        formBodyEl.appendChild(form);

        mountSplitScreen(loginRoot, function(inner) {
          var hdr = document.createElement('div');
          hdr.className = 'diskominfo-form-header';
          hdr.innerHTML =
            '<h1 class="diskominfo-main-title">Daftar Akun Baru</h1>' +
            '<p class="diskominfo-main-subtitle">Isi data diri Anda untuk membuat akun IT Helpdesk Diskominfo</p>';
          inner.appendChild(hdr);

          inner.appendChild(formBodyEl);
          inner.appendChild(buildBackButton());
        });
        return true;
      }

      /* ── Password Reset view ─────────────────────────────── */

      function enhancePasswordReset(loginRoot, heroUnit) {
        var logoImg = heroUnit.querySelector('.company-logo') || heroUnit.querySelector('.diskominfo-hero-logo');
        if (logoImg && logoImg.getAttribute('src')) logoUrlCache = logoImg.getAttribute('src');

        var form = heroUnit.querySelector('form#password_reset') || heroUnit.querySelector('form#password-reset') || heroUnit.querySelector('form');
        var retryBtn = heroUnit.querySelector('.retry');
        var isSentState = !form || retryBtn || heroUnit.textContent.toLowerCase().includes('petunjuk') || heroUnit.textContent.toLowerCase().includes('instructions');

        if (isSentState && !form) {
          // Render success confirmation state in Diskominfo Split Screen
          mountSplitScreen(loginRoot, function(inner) {
            var card = document.createElement('div');
            card.className = 'diskominfo-reset-success-card';
            card.innerHTML =
              '<div class="diskominfo-reset-success-icon-wrap">' +
                '<svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#0b5ed7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">' +
                  '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>' +
                  '<polyline points="22,6 12,13 2,6"></polyline>' +
                '</svg>' +
              '</div>' +
              '<h1 class="diskominfo-reset-success-title">Tautan Reset Terkirim</h1>' +
              '<p class="diskominfo-reset-success-desc">' +
                'Petunjuk untuk mereset kata sandi telah dikirimkan ke alamat email Anda. Silakan periksa <strong>Kotak Masuk (Inbox)</strong> atau folder <strong>Spam</strong> pada email Anda.' +
              '</p>' +
              '<div style="width:100%;margin-top:12px;margin-bottom:16px;">' +
                '<a href="#login" class="btn btn--primary btn--diskominfo-submit diskominfo-reset-success-btn" style="text-decoration:none;display:flex;align-items:center;justify-content:center;width:100%;">' +
                  'Kembali ke Halaman Login' +
                '</a>' +
              '</div>' +
              '<div class="diskominfo-reset-retry-wrap">' +
                '<a href="#password_reset" class="js-retry-reset-btn diskominfo-reset-retry-link">' +
                  'Belum menerima email? Kirim ulang' +
                '</a>' +
              '</div>';

            var retryLink = card.querySelector('.js-retry-reset-btn');
            if (retryLink) {
              retryLink.onclick = function(e) {
                e.preventDefault();
                window.location.hash = '#login';
                setTimeout(function() { window.location.hash = '#password_reset'; }, 20);
              };
            }
            inner.appendChild(card);
          });
          return true;
        }

        if (!form) return false;

        var lbl = form.querySelector('label');
        if (lbl) lbl.textContent = 'Alamat Email *';

        var inp = form.querySelector('input[type="text"], input[type="email"], input:not([type="hidden"])');
        if (inp) {
          inp.setAttribute('type', 'email');
          inp.setAttribute('required', 'true');
          inp.setAttribute('pattern', '[^@\\s]+@[^@\\s]+\\.[^@\\s]+');
          inp.placeholder = 'contoh: nama@email.com';
        }

        var submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.btn--primary');
        if (submitBtn) {
          submitBtn.textContent = 'Kirim Tautan Reset';
          submitBtn.className = 'btn btn--primary btn--diskominfo-submit';
          submitBtn.style.cssText = 'margin-top: 24px !important; margin-bottom: 18px !important;';
        }

        // Validate email on submit
        form.addEventListener('submit', function(ev) {
          var inputEl = form.querySelector('input[name="username"], input[type="email"], input[type="text"]');
          var val = inputEl ? inputEl.value.trim() : '';

          if (!val || !val.includes('@') || val.indexOf('@') === 0 || val.indexOf('@') === val.length - 1 || !val.split('@')[1].includes('.')) {
            ev.preventDefault();
            ev.stopPropagation();

            var oldAlert = form.querySelector('.alert--danger, .diskominfo-form-error');
            if (oldAlert) oldAlert.remove();

            var errDiv = document.createElement('div');
            errDiv.className = 'alert alert--danger diskominfo-form-error';
            errDiv.textContent = 'Format email tidak valid. Masukkan alamat email yang benar (contoh: nama@email.com).';
            form.insertBefore(errDiv, form.firstChild);
            if (inputEl) inputEl.focus();
            return false;
          }
        }, true);

        form.querySelectorAll('a[href="#login"], a.btn--secondary').forEach(function(l) { l.remove(); });

        var formBodyEl = document.createElement('div');
        formBodyEl.className = 'diskominfo-form-content';
        formBodyEl.appendChild(form);

        mountSplitScreen(loginRoot, function(inner) {
          var hdr = document.createElement('div');
          hdr.className = 'diskominfo-form-header';
          hdr.innerHTML =
            '<h1 class="diskominfo-main-title">Lupa Kata Sandi?</h1>' +
            '<p class="diskominfo-main-subtitle">Masukkan alamat email Anda yang terdaftar. Kami akan mengirimkan tautan untuk mereset kata sandi.</p>';
          inner.appendChild(hdr);

          inner.appendChild(formBodyEl);
          inner.appendChild(buildBackButton());
        });
        return true;
      }

      /* ── Main dispatcher ─────────────────────────────────── */

      // Each Zammad route renders a root element with a different class:
      //   #login         → #app .login
      //   #signup        → #app .signup
      //   #password_reset→ #app .reset_password
      function getRootAndHash() {
        var hash = getHash();
        var root = null;
        if (hash === 'login' || hash === '') {
          root = document.querySelector('#app .login');
        } else if (hash === 'signup') {
          root = document.querySelector('#app .signup');
        } else if (hash === 'password_reset') {
          root = document.querySelector('#app .reset_password');
        }
        if (!root) root = document.querySelector('#app .fullscreen');
        return { root: root, hash: hash };
      }

      /* ── Title & Favicon Fixer ────────────────────────────── */

      function fixTitleAndFavicon() {
        if (document.title && document.title.includes('Zammad Helpdesk')) {
          document.title = document.title.replace('Zammad Helpdesk', 'IT Helpdesk');
        }
        if (logoUrlCache) {
          ['diskominfo-favicon', 'diskominfo-shortcut-favicon', 'diskominfo-apple-icon'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && el.getAttribute('href') !== logoUrlCache) {
              el.setAttribute('href', logoUrlCache);
            }
          });
        }
      }

      /* ── Alert & Error Message Indonesian Enhancer ─────────── */

      function enhanceAlerts() {
        var alerts = document.querySelectorAll('.alert, .alert--danger, .alert-danger, [role="alert"]');
        alerts.forEach(function(alertEl) {
          var txt = (alertEl.textContent || '').trim();

          if (txt.includes('Login failed') || txt.includes('kredensial') || txt.includes('credentials') || txt.includes('verification step')) {
            alertEl.textContent = 'Gagal masuk. Mohon periksa kembali username/email dan kata sandi Anda.';
          } else if (txt.includes('two-factor') || txt.includes('2FA') || txt.includes('autentikasi dua faktor')) {
            alertEl.textContent = 'Gagal masuk. Silakan periksa kembali metode autentikasi dua faktor Anda.';
          } else if (txt.includes('Could not process your request') || txt.includes('process your request')) {
            alertEl.textContent = 'Gagal memproses permintaan Anda. Silakan coba lagi.';
          } else if (txt.includes('Due to inactivity') || txt.includes('automatically logged out')) {
            alertEl.textContent = 'Sesi Anda telah berakhir karena tidak ada aktivitas. Silakan masuk kembali.';
          } else if (txt.includes('session is no longer valid') || txt.includes('session_invalid')) {
            alertEl.textContent = 'Sesi tidak valid lagi. Silakan masuk kembali.';
          }
        });
      }

      function enhanceView() {
        var rh = getRootAndHash();
        if (!rh.root) return;

        var root     = rh.root;
        var hash     = rh.hash;

        var heroUnit = root.querySelector('.hero-unit');
        if (!heroUnit) return;

        if      (hash === 'login' || hash === '')   enhanceLogin(root, heroUnit);
        else if (hash === 'signup')                  enhanceSignup(root, heroUnit);
        else if (hash === 'password_reset')          enhancePasswordReset(root, heroUnit);

        fixTitleAndFavicon();
        enhanceAlerts();
      }

      /* ── Bootstrap ───────────────────────────────────────── */

      var observer = new MutationObserver(function() {
        enhanceView();
        fixTitleAndFavicon();
        enhanceAlerts();
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });

      window.addEventListener('hashchange', function() {
        setTimeout(function() {
          enhanceView();
          fixTitleAndFavicon();
          enhanceAlerts();
        }, 100);
      });

      document.addEventListener('DOMContentLoaded', function() {
        enhanceView();
        fixTitleAndFavicon();
        enhanceAlerts();
      });
    })();
  <% end -%>
  <%= csrf_meta_tags %>
</head>
<body>

  <%= content_for?(:content) ? yield(:content) : yield %>

</body>
</html>
