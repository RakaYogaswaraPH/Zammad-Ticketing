      /* ── Ticket Zoom SLA Track Record Display (Realtime) ─────────── */
      var _ticketSlaCache = {};
      var _activeTicketSlaId = null;
      var _ticketSlaPollTimer = null;
      var _ticketSlaLiveTimer = null;

      function isDarkTheme() {
        var html = document.documentElement;
        return html.getAttribute('data-theme') === 'dark' || html.dataset.theme === 'dark';
      }

      function formatSlaLiveDuration(diffSec) {
        if (diffSec <= 0) return '< 1 menit';
        var days = Math.floor(diffSec / 86400);
        var hours = Math.floor((diffSec % 86400) / 3600);
        var mins = Math.floor((diffSec % 3600) / 60);
        var secs = Math.floor(diffSec % 60);

        var parts = [];
        if (days > 0) parts.push(days + ' hari');
        if (hours > 0) parts.push(hours + ' jam');
        if (mins > 0 || (days === 0 && hours === 0)) parts.push(mins + ' mnt');
        if (days === 0) parts.push(secs + ' dtk');
        return parts.join(' ');
      }

      function findActiveTicketZoom(ticketId) {
        // 1. Try finding container by permanent task ID
        if (ticketId) {
          var byId = document.getElementById('content_permanent_Ticket-' + ticketId);
          if (byId) {
            var tzInId = byId.querySelector('.ticketZoom');
            if (tzInId) return tzInId;
          }
          var byId2 = document.getElementById('content_permanent_TicketZoom-' + ticketId);
          if (byId2) {
            var tzInId2 = byId2.querySelector('.ticketZoom');
            if (tzInId2) return tzInId2;
          }
        }

        // 2. Look for active, visible .content container (not .hide)
        var activeContents = document.querySelectorAll('.content.active, .content:not(.hide)');
        for (var i = 0; i < activeContents.length; i++) {
          var c = activeContents[i];
          if (c.closest('#navigation') || c.classList.contains('tasks-navigation')) continue;
          if (c.classList.contains('hide')) continue;
          var tz = c.querySelector('.ticketZoom');
          if (tz && !tz.closest('.hide') && (c.offsetWidth > 0 || c.offsetHeight > 0 || window.getComputedStyle(c).display !== 'none')) {
            return tz;
          }
        }

        // 3. Fallback: check all .ticketZoom elements that are currently visible
        var allTz = document.querySelectorAll('.ticketZoom');
        for (var j = 0; j < allTz.length; j++) {
          var t = allTz[j];
          if (!t.closest('.hide') && (t.offsetWidth > 0 || t.offsetHeight > 0)) {
            return t;
          }
        }

        // 4. Fallback to active main
        var activeMain = document.querySelector('.active.content .main, .content:not(.hide) .main, .main.flex');
        if (activeMain && !activeMain.closest('.hide')) {
          return activeMain.querySelector('.ticketZoom') || activeMain;
        }

        return null;
      }

      var _mountRetryTimer = null;

      function enhanceTicketZoomSla(forcedTicketId) {
        // REQUIREMENT: SLA Card only for Agent / Admin, NEVER for customer!
        if (isCustomerUser() || !isAgentOrAdmin()) {
          document.querySelectorAll('.ticket-sla-track-card').forEach(function(el) { el.remove(); });
          if (_ticketSlaPollTimer) { clearInterval(_ticketSlaPollTimer); _ticketSlaPollTimer = null; }
          if (_ticketSlaLiveTimer) { clearInterval(_ticketSlaLiveTimer); _ticketSlaLiveTimer = null; }
          if (_mountRetryTimer) { clearInterval(_mountRetryTimer); _mountRetryTimer = null; }
          _activeTicketSlaId = null;
          return;
        }

        var hash = window.location.hash || '';
        var match = hash.match(/#ticket\/zoom\/(\d+)/);
        var ticketId = forcedTicketId || (match ? match[1] : null);
        if (!ticketId) {
          if (_ticketSlaPollTimer) { clearInterval(_ticketSlaPollTimer); _ticketSlaPollTimer = null; }
          if (_ticketSlaLiveTimer) { clearInterval(_ticketSlaLiveTimer); _ticketSlaLiveTimer = null; }
          if (_mountRetryTimer) { clearInterval(_mountRetryTimer); _mountRetryTimer = null; }
          _activeTicketSlaId = null;
          return;
        }

        // Clean up any card mistakenly placed in fixed/clipped headers
        var mislocated = document.querySelectorAll('.scrollPageHeader .ticket-sla-track-card, .task-header .ticket-sla-track-card');
        mislocated.forEach(function(el) { el.remove(); });

        // Locate ticketZoom main body
        var ticketZoom = findActiveTicketZoom(ticketId);
        if (!ticketZoom || (!ticketZoom.querySelector('.ticketZoom-header') && !ticketZoom.querySelector('.ticket-article'))) {
          // If DOM is still mounting (e.g. Spine fetching), poll every 80ms up to 4s
          if (!_mountRetryTimer) {
            var retries = 0;
            _mountRetryTimer = setInterval(function() {
              retries++;
              var curHash = window.location.hash || '';
              if (curHash.indexOf('#ticket/zoom/' + ticketId) === -1 || retries > 50) {
                clearInterval(_mountRetryTimer);
                _mountRetryTimer = null;
                return;
              }
              var tz = findActiveTicketZoom(ticketId);
              if (tz && (tz.querySelector('.ticketZoom-header') || tz.querySelector('.ticket-article'))) {
                clearInterval(_mountRetryTimer);
                _mountRetryTimer = null;
                enhanceTicketZoomSla(ticketId);
              }
            }, 80);
          }
          return;
        }

        if (_mountRetryTimer) {
          clearInterval(_mountRetryTimer);
          _mountRetryTimer = null;
        }

        // Check if we need to start or restart polling for this ticket
        if (_activeTicketSlaId !== String(ticketId)) {
          _activeTicketSlaId = String(ticketId);
          if (_ticketSlaPollTimer) clearInterval(_ticketSlaPollTimer);
          if (_ticketSlaLiveTimer) clearInterval(_ticketSlaLiveTimer);

          _ticketSlaPollTimer = setInterval(function() {
            var currentHash = window.location.hash || '';
            if (currentHash.indexOf('#ticket/zoom/' + ticketId) === -1) {
              clearInterval(_ticketSlaPollTimer);
              _ticketSlaPollTimer = null;
              if (_ticketSlaLiveTimer) {
                clearInterval(_ticketSlaLiveTimer);
                _ticketSlaLiveTimer = null;
              }
              return;
            }
            refreshTicketSlaData(ticketId);
          }, 5000);
        }

        // Immediate render from cache if available so it renders with ZERO delay
        if (_ticketSlaCache[ticketId]) {
          renderTicketSlaCard(ticketId, _ticketSlaCache[ticketId]);
        }

        // Always fetch fresh data immediately
        refreshTicketSlaData(ticketId);
      }

      function refreshTicketSlaData(ticketId) {
        if (isCustomerUser() || !isAgentOrAdmin()) return;

        fetch('/api/v1/sla_reports/ticket_sla/' + ticketId, {
          headers: { 'Accept': 'application/json' }
        })
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(data) {
          if (!data || !data.ticket_id || String(data.ticket_id) !== String(ticketId)) return;
          _ticketSlaCache[ticketId] = data;
          renderTicketSlaCard(ticketId, data);
        })
        .catch(function() {});
      }

      function startLiveSlaTicker(ticketId, createdAtMs, isClosed) {
        if (_ticketSlaLiveTimer) {
          clearInterval(_ticketSlaLiveTimer);
          _ticketSlaLiveTimer = null;
        }
        if (isClosed || !createdAtMs) return;

        function updateTick() {
          var card = document.querySelector('.ticket-sla-track-card[data-ticket-id="' + ticketId + '"]');
          if (!card) return;
          var durEl = card.querySelector('.js-live-duration-text');
          if (!durEl) return;

          var diffSec = Math.max(0, Math.floor((Date.now() - createdAtMs) / 1000));
          durEl.textContent = '' + formatSlaLiveDuration(diffSec);
        }

        updateTick();
        _ticketSlaLiveTimer = setInterval(updateTick, 1000);
      }

      function renderTicketSlaCard(ticketId, data) {
        if (isCustomerUser() || !isAgentOrAdmin()) return;

        var ticketZoom = findActiveTicketZoom(ticketId);
        if (!ticketZoom) return;

        var headerEl = ticketZoom.querySelector('.ticketZoom-header');
        var articleEl = ticketZoom.querySelector('.ticket-article, .article-new, .article-view');
        var anchor = headerEl || articleEl;
        if (!anchor) return;
        var parent = anchor.parentElement;
        if (!parent) return;

        var position = headerEl ? 'after' : 'before';

        var isClosed = data.is_closed;
        var statusBadge = isClosed ? 
          '<span class="sla-badge-within">✓ Selesai & Ditutup</span>' : 
          '<span style="background:#e0f2fe;color:#0369a1;padding:4px 10px;border-radius:6px;font-weight:700;font-size:12px;display:inline-flex;align-items:center;gap:4px;">⏳ ' + escapeHtml(data.state_human || 'Sedang Diproses') + '</span>';

        var initialDurationText = '' + escapeHtml(data.duration_human || '-');
        if (!isClosed && data.created_at_ms) {
          var diffSec = Math.max(0, Math.floor((Date.now() - data.created_at_ms) / 1000));
          initialDurationText = '' + formatSlaLiveDuration(diffSec);
        }

        var innerMarkup = 
          '<div class="sla-track-card-header">' +
            '<div class="sla-track-card-title">' +
              '<span>Waktu Pengerjaan Tiket</span>' +
            '</div>' +
            '<div>' + statusBadge + '</div>' +
          '</div>' +
          '<div class="sla-track-grid">' +
            '<div class="sla-track-item">' +
              '<div class="sla-track-label">Waktu Tiket Masuk</div>' +
              '<div class="sla-track-val">' + escapeHtml(data.created_at || '-') + '</div>' +
            '</div>' +
            '<div class="sla-track-item">' +
              '<div class="sla-track-label">Waktu Tiket Ditutup</div>' +
              '<div class="sla-track-val">' + escapeHtml(data.close_at || (isClosed ? 'Ditutup' : 'Belum Ditutup')) + '</div>' +
            '</div>' +
            '<div class="sla-track-item sla-track-duration">' +
              '<div class="sla-track-label">' + (isClosed ? 'Total Durasi Pengerjaan' : 'Durasi Berjalan') + '</div>' +
              '<div class="sla-track-val js-live-duration-text" style="font-variant-numeric: tabular-nums;">' + initialDurationText + '</div>' +
            '</div>' +
          '</div>';

        var existingCards = ticketZoom.querySelectorAll('.ticket-sla-track-card');
        var matched = false;
        existingCards.forEach(function(c) {
          if (!matched && c.getAttribute('data-ticket-id') === String(data.ticket_id)) {
            c.innerHTML = innerMarkup;
            c.setAttribute('data-is-closed', String(isClosed));
            matched = true;
          } else {
            c.remove();
          }
        });

        if (!matched) {
          var card = document.createElement('div');
          card.className = 'ticket-sla-track-card';
          card.setAttribute('data-ticket-id', data.ticket_id);
          card.setAttribute('data-is-closed', String(isClosed));
          card.innerHTML = innerMarkup;

          if (position === 'after') {
            if (anchor.nextSibling) {
              parent.insertBefore(card, anchor.nextSibling);
            } else {
              parent.appendChild(card);
            }
          } else {
            parent.insertBefore(card, anchor);
          }
        }

        // Start live ticker every second for open tickets
        startLiveSlaTicker(data.ticket_id, data.created_at_ms, isClosed);
      }

