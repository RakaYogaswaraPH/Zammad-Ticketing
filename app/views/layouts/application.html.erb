    /* Right Form Section (50% Fullscreen Form Container) */
    .diskominfo-form-section {
      flex: 0 0 50% !important;
      width: 50% !important;
      height: 100vh !important;
      min-height: 100vh !important;
      background: #ffffff !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: 48px 32px !important;
      box-sizing: border-box !important;
      overflow-y: auto !important;
    }

    /* Smooth View Transition Animations */
    @keyframes diskominfoCardSlideIn {
      0% {
        opacity: 0;
        transform: translateY(16px) scale(0.985);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes diskominfoCardSlideOut {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(-12px) scale(0.985);
      }
    }

    .diskominfo-form-inner-wrapper {
      width: 100% !important;
      max-width: 440px !important;
      margin: auto !important;
      display: flex !important;
      flex-direction: column !important;
      text-align: center !important;
      align-items: center !important;
      animation: diskominfoCardSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      will-change: opacity, transform !important;
    }

    .diskominfo-form-inner-wrapper.is-navigating-out,
    .diskominfo-reset-success-card.is-navigating-out {
      animation: diskominfoCardSlideOut 0.14s cubic-bezier(0.4, 0, 1, 1) forwards !important;
      pointer-events: none !important;
    }

    .diskominfo-form-header {
      margin-bottom: 32px !important;
      text-align: center !important;
      width: 100% !important;
    }

    .diskominfo-main-title {
      font-size: 32px !important;
      font-weight: 800 !important;
      color: #0f172a !important;
      margin: 0 0 8px 0 !important;
      letter-spacing: -0.6px !important;
      line-height: 1.2 !important;
      text-align: center !important;
    }

    .diskominfo-main-subtitle {
      font-size: 14px !important;
      color: #64748b !important;
      margin: 0 auto !important;
      max-width: 380px !important;
      line-height: 1.5 !important;
      text-align: center !important;
    }

    /* Form Groups & Inputs */
    .diskominfo-form-content {
      width: 100% !important;
    }

    .diskominfo-form-content .form-group {
      margin-bottom: 18px !important;
      text-align: left !important;
    }

    .diskominfo-form-content .formGroup-label label {
      color: #334155 !important;
      font-weight: 700 !important;
      font-size: 12px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.6px !important;
      margin-bottom: 6px !important;
      display: block !important;
      text-align: left !important;
    }

    .diskominfo-form-content .form-control {
      width: 100% !important;
      height: 48px !important;
      background-color: #f8fafc !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #0f172a !important;
      border-radius: 10px !important;
      padding: 0 16px !important;
      font-size: 14px !important;
      box-sizing: border-box !important;
      transition: all 0.2s ease-in-out !important;
    }

    .diskominfo-form-content .form-control:focus {
      background-color: #ffffff !important;
      border-color: #0b5ed7 !important;
      box-shadow: 0 0 0 3.5px rgba(11, 94, 215, 0.15) !important;
      outline: none !important;
    }

    /* Inline Actions (Remember Me & Forgot Password) */
    .form-group--inline-actions {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      margin: 12px 0 24px 0 !important;
    }

    .login .checkbox-replacement,
    .signup .checkbox-replacement,
    .reset_password .checkbox-replacement,
    .fullscreen .checkbox-replacement {
      display: inline-flex !important;
      align-items: center !important;
      gap: 8px !important;
      color: #475569 !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      cursor: pointer !important;
      user-select: none !important;
      margin: 0 !important;
      position: relative !important;
      transition: color 0.15s ease-in-out !important;
    }

    .login .checkbox-replacement:hover,
    .signup .checkbox-replacement:hover,
    .reset_password .checkbox-replacement:hover,
    .fullscreen .checkbox-replacement:hover {
      color: #0b5ed7 !important;
    }

    .login .checkbox-replacement input[type="checkbox"],
    .signup .checkbox-replacement input[type="checkbox"],
    .reset_password .checkbox-replacement input[type="checkbox"],
    .fullscreen .checkbox-replacement input[type="checkbox"] {
      position: absolute !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      margin: 0 !important;
      pointer-events: none !important;
    }

    /* Hide Zammad SVGs inside checkbox-replacement ONLY on login/signup pages */
    .login .checkbox-replacement .icon,
    .login .checkbox-replacement svg:not(.custom-check-svg),
    .signup .checkbox-replacement .icon,
    .signup .checkbox-replacement svg:not(.custom-check-svg),
    .reset_password .checkbox-replacement .icon,
    .reset_password .checkbox-replacement svg:not(.custom-check-svg),
    .fullscreen .checkbox-replacement .icon,
    .fullscreen .checkbox-replacement svg:not(.custom-check-svg) {
      display: none !important;
    }

    /* Checkbox Box (Unchecked) */
    .login .checkbox-replacement .checkbox-box,
    .signup .checkbox-replacement .checkbox-box,
    .reset_password .checkbox-replacement .checkbox-box,
    .fullscreen .checkbox-replacement .checkbox-box {
      width: 18px !important;
      height: 18px !important;
      border: 1.5px solid #cbd5e1 !important;
      border-radius: 4px !important;
      background-color: #ffffff !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      transition: all 0.15s ease-in-out !important;
      flex-shrink: 0 !important;
      box-sizing: border-box !important;
    }

    /* Hover state */
    .login .checkbox-replacement:hover .checkbox-box,
    .signup .checkbox-replacement:hover .checkbox-box,
    .reset_password .checkbox-replacement:hover .checkbox-box,
    .fullscreen .checkbox-replacement:hover .checkbox-box {
      border-color: #0b5ed7 !important;
    }

    /* White checkmark inside the checkbox box using CSS ::after */
    .login .checkbox-replacement .checkbox-box::after,
    .signup .checkbox-replacement .checkbox-box::after,
    .reset_password .checkbox-replacement .checkbox-box::after,
    .fullscreen .checkbox-replacement .checkbox-box::after {
      content: "" !important;
      width: 4px !important;
      height: 8px !important;
      border: solid #ffffff !important;
      border-width: 0 2px 2px 0 !important;
      transform: rotate(45deg) scale(0) !important;
      position: absolute !important;
      top: 1.5px !important;
      left: 5px !important;
      opacity: 0 !important;
      transition: transform 0.15s ease-in-out, opacity 0.15s ease-in-out !important;
    }

    /* Checked State */
    .login .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box,
    .signup .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box,
    .reset_password .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box,
    .fullscreen .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box {
      background-color: #0b5ed7 !important;
      border-color: #0b5ed7 !important;
    }

    .login .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box::after,
    .signup .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box::after,
    .reset_password .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box::after,
    .fullscreen .checkbox-replacement input[type="checkbox"]:checked ~ .checkbox-box::after {
      opacity: 1 !important;
      transform: rotate(45deg) scale(1) !important;
    }

    /* Label text turns blue when checked */
    .login .checkbox-replacement input[type="checkbox"]:checked ~ .label-text,
    .signup .checkbox-replacement input[type="checkbox"]:checked ~ .label-text,
    .reset_password .checkbox-replacement input[type="checkbox"]:checked ~ .label-text,
    .fullscreen .checkbox-replacement input[type="checkbox"]:checked ~ .label-text {
      color: #0b5ed7 !important;
      font-weight: 600 !important;
    }

    .diskominfo-forgot-password-link {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #0b5ed7 !important;
      text-decoration: none !important;
      transition: color 0.15s !important;
    }

    .diskominfo-forgot-password-link:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    /* Alert & Error Animation */
    @keyframes diskominfoAlertSlideDown {
      0% {
        opacity: 0;
        transform: translateY(-10px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .alert,
    .alert--danger,
    .alert-danger {
      background-color: #ef4444 !important;
      color: #ffffff !important;
      border: none !important;
      border-radius: 10px !important;
