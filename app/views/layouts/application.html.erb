    /* ==========================================================================
       Diskominfo Zammad - Minimalist Admin & Dashboard Custom Theme
       Supports both Light Mode & Dark Mode ([data-theme="dark"])
       ========================================================================== */

    /* ── Comprehensive Blue-Black Dark Theme Variables ── */
    [data-theme='dark'] {
      --background-primary: #0b1120 !important;          /* Deepest blue-black for page body & content */
      --background-primary-alt: #0f172a !important;      /* Slate 900 for surfaces */
      --background-secondary: #1e293b !important;        /* Slate 800 for cards, boxes, tables, first steps */
      --background-secondary-hover: #334155 !important;  /* Slate 700 for hover states */
      --background-tertiary: #0f172a !important;         /* Sub-sidebars, Manage list, panels */
      --background-quaternary: #0b1120 !important;       /* Main navigation bar */
      --background-quaternary-alt: #1e293b !important;   /* Secondary containers */
      --background-popover: #1e293b !important;          /* Popovers & dropdowns */
      --background-highlight: #1e3a8a !important;        /* Deep blue highlight */
      --background-article-meta: #1e293b !important;
      --background-article-customer: #1e293b !important;
      --background-article-customer-meta: #1e293b !important;
      --background-modifier-accent: rgba(255, 255, 255, 0.05) !important;
      --background-modifier-accent-light: rgba(255, 255, 255, 0.03) !important;
      --background-modifier-accent-dark: rgba(0, 0, 0, 0.3) !important;
      --background-modifier-lighter: rgba(255, 255, 255, 0.07) !important;
      --background-modifier-border: rgba(255, 255, 255, 0.08) !important;
      --background-modifier-hover: rgba(59, 130, 246, 0.12) !important;

      --border: #1e293b !important;
      --border-alt: rgba(255, 255, 255, 0.08) !important;
      --border-highlight: #3b82f6 !important;

      --menu-background-primary: #0b1120 !important;
      --menu-background-secondary: #0b1120 !important;
      --menu-background-primary-hover: rgba(255, 255, 255, 0.09) !important;
      --menu-background-active: #2563eb !important;

      --table-header-background: #0f172a !important;
      --table-border: #1e293b !important;

      --text-normal: #f1f5f9 !important;
      --text-muted: #94a3b8 !important;
      --text-muted-alt: #64748b !important;
      --header-primary: #ffffff !important;
      --header-secondary: #cbd5e1 !important;
    }

    /* ── 1. Global App Layout & Typography ───────────────────────────────────── */
    #app {
