<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title><%= Setting.get('product_name') %></title>
  <link rel="apple-touch-icon" href="apple-touch-icon.png" />
  <%= stylesheet_link_tag "application", :media => 'all' %>
  <%= stylesheet_link_tag "application-print", :media => 'print' %>
  <%= javascript_tag nonce: true do -%>
    if(window.MSInputMethodContext && document.documentMode){
      var polyfillScriptTag = document.createElement('script');
      polyfillScriptTag.setAttribute('src', '<%= path_to_javascript('ie11CustomProperties.min') %>');
      polyfillScriptTag.setAttribute('nonce', '<%= content_security_policy_nonce %>');
      document.head.appendChild(polyfillScriptTag);
    }

    try {
      if(window.matchMedia('(prefers-color-scheme: dark)').matches && localStorage.getItem('theme') != 'light' && !window.location.href.includes('/tests_') ){
        document.documentElement.dataset.theme = 'dark';
      }
    } catch (e) { };
  <% end -%>
  <% if Rails.configuration.assets.debug %>
    <%= javascript_include_tag "application", nonce: true %>
  <% else %>
    <%= javascript_include_tag "application", nonce: true, :defer => 'defer' %>
  <% end %>

  <%# Statically include external files with a nonce here to conform to CSP properly. %>
  <%# Required by form channel configuration preview. %>
  <%= javascript_include_tag "../assets/form/form.js", nonce: true, :defer => 'defer', :skip_pipeline => true, :id => "zammad_form_script"  %>

  <%# Required for browser time mocking in tests. %>
  <% if Rails.env.test? %>
    <%= javascript_include_tag "../assets/tests/sinon-9.2.4.js", nonce: true, :skip_pipeline => true, :id => "zammad_form_script"  %>
  <% end %>

  <style nonce="<%= content_security_policy_nonce %>">
    /* Diskominfo Custom Login Theme */
    .login.fullscreen,
    .reset_password.fullscreen,
    .signup.fullscreen,
    .request_admin_password_auth.fullscreen {
      background: #f1f5f9 !important;
      color: #334155 !important;
    }

    .login.fullscreen .fullscreen-body > p,
    .reset_password.fullscreen .fullscreen-body > p,
    .signup.fullscreen .fullscreen-body > p {
      color: #475569 !important;
      font-weight: 500 !important;
      font-size: 14px !important;
    }

    .login .hero-unit,
    .reset_password .hero-unit,
    .signup .hero-unit,
    .request_admin_password_auth .hero-unit {
      background-color: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      border-radius: 16px !important;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04) !important;
      color: #1e293b !important;
      padding: 32px 28px !important;
    }

    .login .company-logo {
      max-height: 80px !important;
      max-width: 180px !important;
      margin: 8px auto 14px !important;
      display: block !important;
      object-fit: contain;
    }

    .login-brand-title {
      text-align: center;
      color: #0b5ed7 !important;
      font-weight: 700 !important;
      font-size: 16px !important;
      line-height: 1.4 !important;
      margin: 0 auto 24px auto !important;
      letter-spacing: -0.2px !important;
      font-family: inherit;
    }

    .login .form-group {
      margin-bottom: 18px !important;
    }

    .login .formGroup-label label {
      color: #334155 !important;
      font-weight: 600 !important;
      font-size: 13px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.5px !important;
      margin-bottom: 6px !important;
    }

    .login .form-control {
      background-color: #f8fafc !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #0f172a !important;
      border-radius: 8px !important;
      padding: 10px 14px !important;
      font-size: 14px !important;
      transition: all 0.2s ease-in-out !important;
    }

    .login .form-control:focus {
      background-color: #ffffff !important;
      border-color: #0b5ed7 !important;
      box-shadow: 0 0 0 3.5px rgba(11, 94, 215, 0.15) !important;
      outline: none !important;
    }

    .login .checkbox-replacement {
      color: #475569 !important;
      font-size: 14px !important;
    }

    .login .checkbox-replacement .label-text {
      color: #475569 !important;
    }

    .login .btn--primary,
    .reset_password .btn--primary,
    .signup .btn--primary {
      background-color: #0b5ed7 !important;
      border: 1px solid #0b5ed7 !important;
      color: #ffffff !important;
      border-radius: 8px !important;
      padding: 11px 18px !important;
      font-weight: 600 !important;
      font-size: 15px !important;
      letter-spacing: 0.2px !important;
      box-shadow: 0 4px 12px rgba(11, 94, 215, 0.25) !important;
      transition: all 0.2s ease-in-out !important;
    }

    .login .btn--primary:hover,
    .reset_password .btn--primary:hover,
    .signup .btn--primary:hover {
      background-color: #0a58ca !important;
      border-color: #0a58ca !important;
      box-shadow: 0 6px 16px rgba(11, 94, 215, 0.35) !important;
      transform: translateY(-1px) !important;
    }

    .login .btn--primary:active,
    .reset_password .btn--primary:active,
    .signup .btn--primary:active {
      background-color: #094bac !important;
      transform: translateY(0) !important;
    }

    .login .btn--text.btn--secondary {
      color: #0b5ed7 !important;
      font-weight: 500 !important;
      font-size: 14px !important;
      margin-top: 12px !important;
      text-decoration: none !important;
    }

    .login .btn--text.btn--secondary:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    .login .js-footer p,
    .reset_password .js-footer p,
    .signup .js-footer p {
      color: #64748b !important;
      font-size: 13px !important;
      line-height: 1.6 !important;
    }

    .login .js-footer a,
    .reset_password .js-footer a,
    .signup .js-footer a {
      color: #0b5ed7 !important;
      font-weight: 600 !important;
      text-decoration: none !important;
    }

    .login .js-footer a:hover,
    .reset_password .js-footer a:hover,
    .signup .js-footer a:hover {
      color: #0a58ca !important;
      text-decoration: underline !important;
    }

    .login .js-footer hr {
      border-top: 1px solid #e2e8f0 !important;
      margin: 16px auto !important;
    }

    .login .poweredBy {
      color: #94a3b8 !important;
      font-size: 13px !important;
    }

    .login .poweredBy a {
      color: #64748b !important;
    }

    .login .poweredBy a:hover {
      color: #0b5ed7 !important;
    }
  </style>
  <%= javascript_tag nonce: true do -%>
    (function() {
      function ensureLoginSubtitle() {
        var logo = document.querySelector('.login .company-logo');
        if (logo && !logo.parentNode.querySelector('.login-brand-title')) {
          var title = document.createElement('div');
          title.className = 'login-brand-title';
          title.textContent = 'IT Helpdesk Diskominfo Kabupaten Bandung';
          logo.parentNode.insertBefore(title, logo.nextSibling);
        }
      }
      var observer = new MutationObserver(ensureLoginSubtitle);
      observer.observe(document.documentElement, { childList: true, subtree: true });
      window.addEventListener('hashchange', ensureLoginSubtitle);
      document.addEventListener('DOMContentLoaded', ensureLoginSubtitle);
    })();
  <% end -%>
  <%= csrf_meta_tags %>
</head>
<body>

  <%= content_for?(:content) ? yield(:content) : yield %>

</body>
</html>
