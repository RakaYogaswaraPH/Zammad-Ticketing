      function isAgentOrAdmin() {
        if (!window.App || !window.App.Session) return false;
        var user = window.App.Session.get();
        if (!user || typeof user.permission !== 'function') return false;
        return user.permission('ticket.agent') || user.permission('admin') || user.permission('admin.*');
      }

